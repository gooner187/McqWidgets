  revealBtn.addEventListener("click",function(){if(finished)return;if(!revealed){revealSaved=placed.slice();placed=circ.answers.slice();checkCols=circ.answers.map(function(a,i){return revealSaved[i]===a?"ok":"reveal";});revealed=true;revealBtn.textContent="\uD83D\uDCD5 Hide";feedbackEl.style.color="var(--text-muted)";feedbackEl.textContent="Green=you had it right. Blue=revealed.";checkBtn.disabled=true;finishBtn.disabled=true;redraw();}else{placed=revealSaved;checkCols=null;revealed=false;revealBtn.textContent="\uD83D\uDCD6 Reveal";feedbackEl.textContent="";checkBtn.disabled=false;finishBtn.disabled=false;redraw();}});
