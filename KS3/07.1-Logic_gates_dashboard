    svg += '<line x1="0" y1="50" x2="42" y2="50" stroke="'+wc(inputs.A)+'" stroke-width="'+sw+'"/>';
    // NOT gate: cx=58, cy=50, h=40 — output at x=90, y=50
    svg += drawNOT(58, 50, {h:40, stroke:notStroke, strokeWidth:sw});
    // Wire from NOT output to AND top input
    svg += '<line x1="90" y1="50" x2="120" y2="50" stroke="'+wc(na)+'" stroke-width="'+sw+'"/>';

    // B wire stub → AND bottom input
    svg += '<line x1="0" y1="72" x2="120" y2="72" stroke="'+wc(inputs.B)+'" stroke-width="'+sw+'"/>';

    // AND gate: cx=142, cy=61, h=42, w=44 — output at x=185, y=61
    svg += drawAND(142, 61, {h:42, w:44, stroke:andStroke, strokeWidth:sw});
    // Wire extends 25px past gate output before Q= label — matches AND tutorial proportions
    svg += '<line x1="185" y1="61" x2="210" y2="61" stroke="'+wc(out)+'" stroke-width="'+sw+'"/>';
    svg += '<text x="213" y="65" font-family="Inter,system-ui,Segoe UI,Arial,sans-serif" font-size="11" font-weight="700" fill="'+wc(out)+'">Q</text>';

    svg += '</svg>';
    return svg;
  }

  svgWrap.innerHTML = buildSVG();
  gateArea.appendChild(svgWrap);

  // Output bulb
  var bulbWrap = document.createElement("div");
  bulbWrap.className = "lg-bulb-wrap";
  bulbWrap.style.marginTop = "8px";
