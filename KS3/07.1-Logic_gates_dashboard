.lg-tt tr.active td{background:#fff1c2;color:#6b4300;font-weight:900}
.lg-challenge-desc{font-size:15px;color:#345778;margin-bottom:1rem;line-height:1.5}
.lg-challenge-tt td{padding:5px 8px;border-top:1px solid #e1ebf6;text-align:center}
.lg-challenge-tt .given{color:var(--text);font-weight:800;padding:7px 16px}
.lg-inp{width:60px;background:#fff;border:2px solid #c8daee;border-radius:7px;padding:5px;font-size:16px;font-weight:800;color:var(--text);outline:none;text-align:center}
.lg-inp:focus{border-color:#397fc4;box-shadow:0 0 0 3px #397fc433}
.lg-ctrl-bar{display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin-top:.9rem}
.lg-feedback{font-size:14px;color:var(--text-muted);margin-left:4px}
.lg-completion{display:none;padding:10px 14px;border-radius:10px;background:#e7f8eb;border:1px solid #b8e6c2;font-size:15px;color:#17632b;margin-top:.75rem}
.lg-circuit-svg{width:100%;max-width:600px;display:block;margin:0 auto 1rem}

/* Make every page's buttons/inline controls friendlier (inline styles set the colours) */
#toolContent button{font-weight:700;border-radius:8px!important;border-width:2px!important}
#toolContent button:not(.lg-input-btn){font-size:max(13px,1em)}
#toolContent input{font-family:var(--sans)}
#toolContent svg line{stroke-linecap:round}
#toolContent svg text{font-weight:800}
#toolContent p{font-size:15px!important}

/* Live (1) wires: little dashes of current flow along them while animations are on */
.flow{pointer-events:none}
:root.no-motion .flow{display:none}
:root:not(.no-motion) .flow{animation:flow .7s linear infinite}
@keyframes flow{to{stroke-dashoffset:-16}}
:root:not(.no-motion) .gate-on{animation:gatepulse 1.4s ease-in-out infinite}
@keyframes gatepulse{50%{filter:drop-shadow(0 0 6px #7be08f)}}
