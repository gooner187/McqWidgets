// Live wires: any wire carrying a 1 (green) gets a moving dash overlay, so you can see the current flow
(function(){
  var NS = "http://www.w3.org/2000/svg", busy = false;
  function addFlow(){
    busy = true;
    document.querySelectorAll('#toolContent svg line[stroke="#13a52f"]:not([data-flowed])').forEach(function(ln){
      ln.setAttribute("data-flowed","1");
      var f = ln.cloneNode(false);
      f.removeAttribute("data-flowed");
      f.setAttribute("class","flow");
      f.setAttribute("stroke","#d9ffe1");
      f.setAttribute("stroke-dasharray","4 12");
      f.style.strokeWidth = "2.5px";
      ln.parentNode.insertBefore(f, ln.nextSibling);
    });
    busy = false;
  }
  // Diagrams were drawn quite small: scale them up (keeping them inside the card)
  function grow(){
    document.querySelectorAll('#toolContent svg[width]:not([data-grown])').forEach(function(sv){
      sv.setAttribute("data-grown","1");
      var w = parseFloat(sv.getAttribute("width"));
      if (!(w >= 150) || sv.closest(".lg-btn")) return;
      sv.setAttribute("width", Math.round(w*1.45));
      sv.removeAttribute("height");
      sv.style.maxWidth = "100%"; sv.style.height = "auto";
    });
  }
  new MutationObserver(function(){ if (!busy) { busy = true; grow(); busy = false; addFlow(); } }).observe(document.getElementById("toolContent"), {childList:true, subtree:true});
  grow(); addFlow();
})();
