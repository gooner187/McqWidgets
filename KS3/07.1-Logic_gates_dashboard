// Static circuit SVGs for the three truth table circuit challenges
function buildStaticTCSVG(key) {
  var sw = 2.5;
  var s = 'var(--text)';
  var w = 'var(--text-muted)';

  if (key === "tc1") {
    // A AND B — simple AND gate
    var svg = '<svg viewBox="0 0 280 100" width="240" style="max-width:240px;">';
    svg += '<text x="18" y="42" font-family="Inter,system-ui,Segoe UI,Arial,sans-serif" font-size="12" fill="'+s+'" text-anchor="end">A</text>';
    svg += '<line x1="20" y1="37" x2="88" y2="37" stroke="'+w+'" stroke-width="'+sw+'"/>';
    svg += '<text x="18" y="67" font-family="Inter,system-ui,Segoe UI,Arial,sans-serif" font-size="12" fill="'+s+'" text-anchor="end">B</text>';
    svg += '<line x1="20" y1="62" x2="88" y2="62" stroke="'+w+'" stroke-width="'+sw+'"/>';
    svg += drawAND(120, 50, {h:55, w:55, stroke:s, strokeWidth:sw});
    // output: rightX = 120+27.5+27.5=175
    svg += '<line x1="175" y1="50" x2="250" y2="50" stroke="'+w+'" stroke-width="'+sw+'"/>';
    svg += '<text x="258" y="55" font-family="Inter,system-ui,Segoe UI,Arial,sans-serif" font-size="12" fill="'+s+'">Q</text>';
    svg += '</svg>';
    return svg;
  }

  if (key === "tc2") {
    // A OR (NOT A) — A splits: one branch to NOT, NOT output to OR, A also to OR
    var svg = '<svg viewBox="0 0 320 120" width="280" style="max-width:280px;">';
    // A wire splits
    svg += '<text x="18" y="60" font-family="Inter,system-ui,Segoe UI,Arial,sans-serif" font-size="12" fill="'+s+'" text-anchor="end">A</text>';
    svg += '<line x1="20" y1="55" x2="65" y2="55" stroke="'+w+'" stroke-width="'+sw+'"/>';
    // Junction dot
    svg += '<circle cx="65" cy="55" r="6" fill="'+w+'"/>';
    // A up to OR top input
    svg += '<line x1="65" y1="55" x2="65" y2="28" stroke="'+w+'" stroke-width="'+sw+'"/>';
    svg += '<line x1="65" y1="28" x2="178" y2="28" stroke="'+w+'" stroke-width="'+sw+'"/>';
    // A down to NOT gate
    svg += '<line x1="65" y1="55" x2="65" y2="80" stroke="'+w+'" stroke-width="'+sw+'"/>';
    svg += '<line x1="65" y1="80" x2="95" y2="80" stroke="'+w+'" stroke-width="'+sw+'"/>';
    // NOT gate at cx=115, cy=80, h=50
    svg += drawNOT(115, 80, {h:50, stroke:s, strokeWidth:sw});
    // NOT output: 115+20+16=151
    svg += '<line x1="151" y1="80" x2="178" y2="80" stroke="'+w+'" stroke-width="'+sw+'"/>';
    // OR gate at cx=215, cy=54, h=55, w=65
    svg += drawOR(215, 54, {h:55, w:65, stroke:s, strokeWidth:sw});
    // OR output: tipX = 215+32.5=247.5
    svg += '<line x1="248" y1="54" x2="290" y2="54" stroke="'+w+'" stroke-width="'+sw+'"/>';
    svg += '<text x="298" y="59" font-family="Inter,system-ui,Segoe UI,Arial,sans-serif" font-size="12" fill="'+s+'">Q</text>';
    svg += '</svg>';
    return svg;
  }

  if (key === "tc3") {
    // (NOT A) AND (NOT B) — A→NOT, B→NOT, both NOT outputs into AND
    var svg = '<svg viewBox="0 0 340 140" width="300" style="max-width:300px;">';
    // A → NOT gate
    svg += '<text x="18" y="48" font-family="Inter,system-ui,Segoe UI,Arial,sans-serif" font-size="12" fill="'+s+'" text-anchor="end">A</text>';
    svg += '<line x1="20" y1="43" x2="80" y2="43" stroke="'+w+'" stroke-width="'+sw+'"/>';
    svg += drawNOT(100, 43, {h:50, stroke:s, strokeWidth:sw});
    // NOT A output: 100+20+16=136
    svg += '<line x1="136" y1="43" x2="188" y2="43" stroke="'+w+'" stroke-width="'+sw+'"/>';
    // B → NOT gate
    svg += '<text x="18" y="100" font-family="Inter,system-ui,Segoe UI,Arial,sans-serif" font-size="12" fill="'+s+'" text-anchor="end">B</text>';
    svg += '<line x1="20" y1="95" x2="80" y2="95" stroke="'+w+'" stroke-width="'+sw+'"/>';
    svg += drawNOT(100, 95, {h:50, stroke:s, strokeWidth:sw});
    // NOT B output
    svg += '<line x1="136" y1="95" x2="188" y2="95" stroke="'+w+'" stroke-width="'+sw+'"/>';
    // AND gate at cx=223, cy=69, h=62, w=55
    svg += drawAND(223, 69, {h:62, w:55, stroke:s, strokeWidth:sw});
    // AND output: 223+27.5+31=281.5
    svg += '<line x1="282" y1="69" x2="316" y2="69" stroke="'+w+'" stroke-width="'+sw+'"/>';
    svg += '<text x="324" y="74" font-family="Inter,system-ui,Segoe UI,Arial,sans-serif" font-size="12" fill="'+s+'">Q</text>';
    svg += '</svg>';
    return svg;
  }

  return '';
}

// ── SHARED CHALLENGE TABLE BUILDER ────────────────────────────
function buildChallengeTT(container, cols, rows, inputColIdxs) {
  var inputCells = [];
  var xpAwarded = {};
  var finished = false;
  var revealed = false;
  var savedState = null;

  var tbl = document.createElement("table");
  tbl.className = "lg-challenge-tt";
  var thead = document.createElement("thead");
  var hr = document.createElement("tr");
  cols.forEach(function(c) {
    var th = document.createElement("th"); th.textContent = c; hr.appendChild(th);
  });
  thead.appendChild(hr); tbl.appendChild(thead);

  var tbody = document.createElement("tbody");
  rows.forEach(function(row, ri) {
    var tr = document.createElement("tr");
    cols.forEach(function(col, ci) {
      var td = document.createElement("td");
      if (inputColIdxs.indexOf(ci) !== -1) {
        var inp = document.createElement("input");
        inp.type = "text"; inp.className = "lg-inp";
        inp.autocomplete = "off"; inp.spellcheck = false;
        inp.placeholder = "0 or 1";
        inp.addEventListener("focus", function() { inp.style.borderColor = "var(--accent)"; });
        inp.addEventListener("blur",  function() { if (!inp.style.background || inp.style.background === "var(--surface2)") inp.style.borderColor = "var(--border)"; });
        td.appendChild(inp);
        inputCells.push({ input:inp, answer:String(row[ci]), rowIdx:ri, col:col });
      } else {
        td.className = "given";
        td.textContent = row[ci];
      }
      tr.appendChild(td);
    });
    tbody.appendChild(tr);
  });
  tbl.appendChild(tbody);
  container.appendChild(tbl);

  // Controls
  var ctrlBar = document.createElement("div");
  ctrlBar.className = "lg-ctrl-bar";
  var checkBtn  = mkCtrlBtn("\u2713 Check now", "primary");
  var revealBtn = mkCtrlBtn("\uD83D\uDCD6 Reveal answers", "muted");
  var finishBtn = mkCtrlBtn("\u2714 Finished", "primary");
  var feedbackEl = document.createElement("span");
  feedbackEl.className = "lg-feedback";
  ctrlBar.appendChild(checkBtn); ctrlBar.appendChild(revealBtn);
  ctrlBar.appendChild(finishBtn); ctrlBar.appendChild(feedbackEl);
  container.appendChild(ctrlBar);

  var completionBanner = document.createElement("div");
  completionBanner.className = "lg-completion";
  container.appendChild(completionBanner);

  function check(isFinal) {
    var correct=0, wrong=0, blank=0, newXP=0;
    inputCells.forEach(function(cell) {
      var raw = cell.input.value.trim();
      if (!raw) { if (isFinal) { cell.input.style.borderColor="#d6453a"; cell.input.style.background="rgba(214,69,58,0.1)"; } blank++; return; }
      var ok = raw === cell.answer;
      if (ok) {
        correct++;
        cell.input.style.borderColor="#13a52f"; cell.input.style.background="rgba(19,165,47,0.12)"; cell.input.style.color="#13a52f";
        var ck = cell.rowIdx+":"+cell.col;
        if (!xpAwarded[ck]) { xpAwarded[ck]=true; newXP+=2; }
      } else {
        wrong++;
        cell.input.style.borderColor="#d6453a"; cell.input.style.background="rgba(214,69,58,0.1)"; cell.input.style.color="var(--text)";
        if (raw.toLowerCase() === cell.answer.toLowerCase()) {
          cell.input.title = "Almost! The value should be " + cell.answer + ".";
        }
      }
    });
    if (newXP > 0) J277.grantXP(newXP, "logic_gate_challenge");
    return {correct:correct, wrong:wrong, blank:blank, total:inputCells.length};
  }

  function resetChallenge() {
    finished = false; revealed = false; savedState = null;
    xpAwarded = {};
    inputCells.forEach(function(cell) {
      cell.input.value = "";
      cell.input.disabled = false;
      cell.input.style.borderColor = "var(--border)";
      cell.input.style.background = "var(--surface2)";
      cell.input.style.color = "var(--text)";
      cell.input.title = "";
    });
    completionBanner.style.display = "none";
    feedbackEl.textContent = "";
    checkBtn.disabled = false;
    revealBtn.disabled = false;
    revealBtn.textContent = "\uD83D\uDCD6 Reveal answers";
    finishBtn.textContent = "\u2714 Finished";
    finishBtn.disabled = false;
  }

  function showCompletion(total) {
    finished = true;
    inputCells.forEach(function(c){ c.input.disabled = true; });
    J277.grantXP(15, "logic_gate_complete");
    completionBanner.style.display = "block";
    completionBanner.innerHTML = "\uD83C\uDF89 <strong>All " + total + " values correct!</strong>";
    feedbackEl.textContent = "";
    checkBtn.disabled = true; revealBtn.disabled = true;
    finishBtn.textContent = "\uD83D\uDD04 Try again";
    finishBtn.style.borderColor = "var(--accent)";
    finishBtn.style.background = "rgba(57,127,196,0.12)";
    finishBtn.style.color = "var(--accent)";
  }

  checkBtn.addEventListener("click", function() {
    if (finished) return;
    var r = check(false);
    if (r.correct+r.wrong === 0) { feedbackEl.textContent = "Enter some values first."; feedbackEl.style.color="var(--text-muted)"; return; }
    feedbackEl.style.color = r.wrong > 0 ? "#d6453a" : "#13a52f";
    feedbackEl.textContent = r.correct + " correct" + (r.wrong ? ", " + r.wrong + " incorrect" : " \u2714") + (r.blank ? " (" + r.blank + " blank)" : "");
    if (r.correct === r.total) showCompletion(r.total);
  });

  finishBtn.addEventListener("click", function() {
    if (finished) { resetChallenge(); return; }
    var r = check(true);
    if (r.correct === r.total) {
      showCompletion(r.total);
    } else {
      feedbackEl.style.color = "#d6453a";
      feedbackEl.textContent = r.correct + " / " + r.total + " — red cells need fixing.";
      finishBtn.textContent = "\uD83D\uDD04 Try again";
      finishBtn.style.borderColor = "var(--accent)";
      finishBtn.style.background = "rgba(57,127,196,0.12)";
      finishBtn.style.color = "var(--accent)";
      finished = true;
    }
  });

  revealBtn.addEventListener("click", function() {
    if (finished) return;
    if (!revealed) {
      savedState = inputCells.map(function(c){ return {value:c.input.value, bc:c.input.style.borderColor, bg:c.input.style.background, col:c.input.style.color, dis:c.input.disabled}; });
      inputCells.forEach(function(cell) {
        var raw = cell.input.value.trim();
        var wasOk = raw === cell.answer;
        cell.input.value = cell.answer; cell.input.disabled = true;
        if (wasOk) { cell.input.style.borderColor="#13a52f"; cell.input.style.background="rgba(19,165,47,0.12)"; cell.input.style.color="#13a52f"; }
        else { cell.input.style.borderColor="var(--accent)"; cell.input.style.background="rgba(57,127,196,0.08)"; cell.input.style.color="var(--accent)"; }
      });
      revealed = true;
      revealBtn.textContent = "\uD83D\uDCD5 Hide answers";
      feedbackEl.style.color="var(--text-muted)"; feedbackEl.textContent = "Answers revealed. Green = you had it right. Blue = revealed.";
      checkBtn.disabled=true; finishBtn.disabled=true;
    } else {
      inputCells.forEach(function(cell,i){ var s=savedState[i]; cell.input.value=s.value; cell.input.style.borderColor=s.bc; cell.input.style.background=s.bg; cell.input.style.color=s.col; cell.input.disabled=s.dis; });
      revealed = false;
      revealBtn.textContent = "\uD83D\uDCD6 Reveal answers";
      feedbackEl.textContent = "";
      checkBtn.disabled=false; finishBtn.disabled=false;
    }
  });
}

function mkCtrlBtn(label, style) {
  var b = document.createElement("button");
  b.textContent = label;
  var styles = { primary:"border:0.5px solid #13a52f;background:rgba(19,165,47,0.15);color:#13a52f;", muted:"border:0.5px solid var(--border);background:transparent;color:var(--text-muted);" };
  b.style.cssText = "font-size:13px;font-family:Inter,system-ui,Segoe UI,Arial,sans-serif;padding:5px 12px;border-radius:6px;cursor:pointer;transition:opacity 0.15s;" + (styles[style]||styles.muted);
  return b;
}

