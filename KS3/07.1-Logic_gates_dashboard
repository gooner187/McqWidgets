// ════════════════════════════════════════════════════════════
// WRITE THE EXPRESSION
// Student sees a complete logic circuit and types the Boolean
// expression. Answer checking uses truth-table comparison so
// all equivalent forms (commutativity, De Morgan's etc.) pass.
// ════════════════════════════════════════════════════════════

// ── Expression evaluator ──────────────────────────────────────
function _weEval(rawExpr, varVals) {
  // Proper recursive descent parser — no eval() or new Function()
  // Grammar: expr → or ; or → and ('OR' and)* ; and → not ('AND' not)*
  //          not → 'NOT' not | atom ; atom → VAR | '(' expr ')'
  try {
    var s = rawExpr.toUpperCase().trim();
    if (!s) return {error:"empty"};

    // Tokenise
    var tokens = [];
    var i = 0;
    function kwAt(pos, kw) {
      if (s.substr(pos, kw.length) !== kw) return false;
      var nxt = s[pos + kw.length];
      return !nxt || !/[A-Z0-9]/.test(nxt);
    }
    while (i < s.length) {
      if (s[i] === ' ') { i++; continue; }
      if (s[i] === '(') { tokens.push({t:'LP'}); i++; }
      else if (s[i] === ')') { tokens.push({t:'RP'}); i++; }
      else if (kwAt(i,'NOT')) { tokens.push({t:'NOT'}); i+=3; }
      else if (kwAt(i,'AND')) { tokens.push({t:'AND'}); i+=3; }
      else if (kwAt(i,'OR'))  { tokens.push({t:'OR'});  i+=2; }
      else if (/[A-Z]/.test(s[i])) {
        if (varVals.hasOwnProperty(s[i])) { tokens.push({t:'V',v:s[i]}); i++; }
        else return {error:"unknown"};
      }
      else return {error:"invalid"};
    }

    // Parse
    var p = 0;
    function peek() { return tokens[p]; }
    function next() { return tokens[p++]; }

    function parseExpr() { return parseOr(); }
    function parseOr() {
      var v = parseAnd();
      while (peek() && peek().t==='OR') {
        next();
        var r = parseAnd();   // always called — must advance p
        v = (v || r) ? 1 : 0;
      }
      return v;
    }
    function parseAnd() {
      var v = parseNot();
      while (peek() && peek().t==='AND') {
        next();
        var r = parseNot();   // always called — must advance p
        v = (v && r) ? 1 : 0;
      }
      return v;
    }
    function parseNot() {
      if (peek() && peek().t==='NOT') { next(); return parseNot() ? 0 : 1; }
      return parseAtom();
    }
    function parseAtom() {
      var tok = peek();
      if (!tok) throw new Error("Unexpected end");
      if (tok.t==='V') { next(); return varVals[tok.v] ? 1 : 0; }
      if (tok.t==='LP') {
        next();
        var v = parseExpr();
        var cl = next();
        if (!cl || cl.t!=='RP') throw new Error("Missing )");
        return v;
      }
      throw new Error("Unexpected: "+tok.t);
    }

    var result = parseExpr();
    if (p < tokens.length) return {error:"syntax"}; // leftover tokens
    return {value: result ? 1 : 0};
  } catch(e) {
    return {error:"syntax"};
  }
}

function _weCheck(studentExpr, correctExpr, vars) {
  var n = vars.length, rows = Math.pow(2, n);
  for (var i = 0; i < rows; i++) {
    var vals = {};
    for (var j = 0; j < n; j++) vals[vars[j]] = (i >> (n-1-j)) & 1;
    var correct = _weEval(correctExpr, vals);
    var student = _weEval(studentExpr, vals);
    if (student.error) return {ok:false, parseError:student.error};
    if (student.value !== correct.value) {
      var ce = vars.map(function(v){return v+'='+vals[v];}).join(', ');
      return {ok:false, parseError:null, counterExample:ce, got:student.value, expected:correct.value};
    }
  }
  return {ok:true};
}

