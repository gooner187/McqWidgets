  var rows = TRUTH_TABLES[type];
  var cols = isTwoInput ? ["A","B","Q"] : ["A","Q"];
  // Only Q is an input — A and B are pre-filled as given values
  buildChallengeTT(el, cols, rows, [cols.length - 1]);
  el.appendChild(makeChallengeNavBar(type + " truth table"));
}

