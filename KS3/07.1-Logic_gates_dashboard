  var wOn = "#13a52f", wOff = "var(--text-muted)", sw = 2.5;
  function wc(v) { return v ? wOn : wOff; }
  // Aligned layout: NOT top input y == AND top input y (no bent wires needed)
  // NOT: cx=58, cy=50, h=40  → input y=50, output x=58+16+16=90, y=50
  // AND: cx=142, cy=63, h=42, w=44 → top y=63-10.5=52.5≈53, left x=142-22=120
  // Close enough — route NOT output wire slight diagonal or just shift AND top input y to 50
  // Simplest: set AND cy so top input y = NOT cy = 50
  // AND top input y = AND cy - h*0.25, so AND cy = 50 + 42*0.25 = 50+10.5 = 60.5 ≈ 61
