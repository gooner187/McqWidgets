<script>/* Animations are ON by default (school PCs often have Windows animations off); the header switch turns them off */
try{if(localStorage.getItem("logicGates.motion")==="off")document.documentElement.classList.add("no-motion")}catch(e){}</script>
<style>
:root{
  --text:#123252;--text-primary:#123252;--text-secondary:#345778;--text-muted:#5a7591;
  --surface:#fbfdff;--surface2:#eef5fd;--surface-2:#eef5fd;--bg:#e6eef8;--border:#c8daee;
  --accent:#397fc4;--accent2:#7c4dff;--radius:10px;
  --on:#13a52f;--bad:#d6453a;--yellow:#ffc51c;
  --sans:Inter,system-ui,"Segoe UI",Arial,sans-serif;
}
*{box-sizing:border-box}
html,body{margin:0}
body{background:#edf3fa;color:var(--text);font-family:var(--sans)}
button{font-family:var(--sans)!important}
.app{max-width:1200px;margin:12px auto;padding:12px;background:#fbfdff;border:1px solid #dce7f2;box-shadow:0 4px 18px #17395718;border-radius:12px;display:flex;flex-direction:column}
header{flex:0 0 auto;height:60px;background:linear-gradient(100deg,#173653,#254d70);border-radius:8px;color:#fff;display:flex;align-items:center;padding:0 20px;gap:14px}
.logo{width:40px;height:40px;flex:none}
h1{font-size:clamp(19px,2vw,27px);margin:0;display:flex;align-items:center;gap:10px;white-space:nowrap}
.brand{text-decoration:none;cursor:pointer;display:inline-block;font:900 13px/1 Inter,system-ui,Arial,sans-serif;letter-spacing:.06em;color:#183956;background:#ffc51c;border:2px solid #111b25;border-radius:7px;padding:4px 7px 4px 8px;transform:rotate(-4deg);box-shadow:2px 2px 0 #111b25}
:root:not(.no-motion) .brand{transition:transform .15s,box-shadow .15s,background .15s}
.brand:hover{background:#ffd84d;transform:rotate(-4deg) translateY(-1px);box-shadow:3px 3px 0 #111b25}
.brand:focus-visible{outline:3px solid #fff;outline-offset:3px}
.hsub{font-size:13px;color:#b9d2ea;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;min-width:0}
.hright{margin-left:auto;display:flex;align-items:center;gap:10px}
.homebtn{border:0;border-radius:8px;background:#ffffff26;color:#fff;font-weight:800;padding:8px 13px;cursor:pointer;font-size:14px;white-space:nowrap}
.homebtn:hover{background:#ffffff3d}
.motion-toggle{display:flex;align-items:center;gap:.5em;font:inherit;font-size:13px;font-weight:700;color:#173957;background:#fff;border:2px solid #111;border-radius:999px;padding:.25em .4em .25em .8em;cursor:pointer;flex:none}
.motion-toggle .track{position:relative;width:2.3em;height:1.3em;border-radius:999px;background:#a7b3ba;flex:none}
.motion-toggle .knob{position:absolute;top:.15em;left:.15em;width:1em;height:1em;border-radius:50%;background:#fff;box-shadow:0 0 0 1px rgb(0 0 0/.25)}
:root:not(.no-motion) .motion-toggle .track{transition:background 150ms}:root:not(.no-motion) .motion-toggle .knob{transition:transform 150ms}
.motion-toggle[aria-checked="true"] .track{background:#27a845}.motion-toggle[aria-checked="true"] .knob{transform:translateX(1em)}
.motion-toggle:focus-visible{outline:3px solid #ffd34d;outline-offset:3px}
@media(max-width:1000px){.hsub{display:none}}
@media(max-width:700px){.brand{display:none}}
@media(max-width:560px){header{padding:0 9px;gap:8px}.motion-toggle span:first-child{display:none}.homebtn{padding:6px 9px;font-size:12px}.app{margin:0;border-radius:0}}
.tool-card{margin-top:12px;flex:1;min-height:0;overflow:auto;border:1px solid #cbdff4;border-radius:10px;background:linear-gradient(145deg,#f4f8fe,#eaf2fc);padding:16px 20px}
#toolContent{font-family:var(--sans);max-width:1000px;margin:0 auto}
@media(min-width:701px){
  html,body{height:100%;overflow:hidden}
  .app{height:calc(100vh - 24px);height:calc(100dvh - 24px)}
}
@media(max-width:700px){.tool-card{padding:12px}}

/* ---------- Landing ---------- */
.lg-landing{padding:0}
.lg-intro{display:flex;align-items:center;gap:14px;background:#fff;border:1px solid #cbdff4;border-radius:12px;padding:10px 16px;margin-bottom:14px}
.lg-intro .ico{width:44px;height:44px;flex:none;border-radius:50%;background:#fff1c2;display:grid;place-items:center;font-size:24px}
.lg-intro h2{margin:0 0 2px;font-size:18px}.lg-intro p{margin:0;font-size:14px;color:#345778;line-height:1.4}
.lg-cats{display:grid;grid-template-columns:1fr 1fr;gap:12px}
@media(max-width:760px){.lg-cats{grid-template-columns:1fr}}
.lg-cat{background:#fff;border:1px solid #cbdff4;border-radius:12px;padding:10px 12px 12px}
.lg-category-heading{display:flex;align-items:center;gap:8px;font-size:15px;font-weight:800;color:#183956;margin:0 0 8px}
.lg-category-heading .pill{font-size:13px;font-weight:800;letter-spacing:.04em;text-transform:uppercase;border-radius:999px;padding:3px 9px;background:#dce9f8;color:#173957}
.lg-cat.c1 .pill{background:#fff1c2;color:#6b4300}.lg-cat.c2 .pill{background:#dff6e4;color:#17632b}.lg-cat.c3 .pill{background:#e4ecfb;color:#1d4f8c}.lg-cat.c4 .pill{background:#ece4ff;color:#4a22c0}
