];

function makeChallengeNavBar(currentLabel) {
  var idx = -1;
  for (var _i = 0; _i < CHALLENGE_SEQUENCE.length; _i++) {
    if (CHALLENGE_SEQUENCE[_i].label === currentLabel) { idx = _i; break; }
  }
  if (idx === -1) return document.createDocumentFragment();

  var wrap = document.createElement("div");
  wrap.style.cssText = "display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin-top:1rem;padding-top:0.75rem;border-top:0.5px solid var(--border);justify-content:space-between;";

  function mkNavBtn(label, fn, isPrimary) {
    var btn = document.createElement("button");
    btn.textContent = label;
    var base = isPrimary
      ? "border:0.5px solid var(--accent);background:rgba(57,127,196,0.12);color:var(--accent);"
      : "border:0.5px solid var(--border);background:var(--surface2);color:var(--text-muted);";
    btn.style.cssText = "font-size:0.85rem;font-family:Inter,system-ui,Segoe UI,Arial,sans-serif;padding:5px 14px;border-radius:6px;cursor:pointer;transition:opacity 0.15s;" + base;
    btn.addEventListener("click", fn);
    return btn;
  }

  var leftGroup = document.createElement("div");
  leftGroup.style.cssText = "display:flex;gap:8px;";
  var rightGroup = document.createElement("div");
  rightGroup.style.cssText = "display:flex;gap:8px;";

  // Don't show a Previous button that crosses section boundaries —
  // truth table challenges are a separate track from circuit challenges
  var sectionStarts = ["AND truth table", "A AND B"];
  if (idx > 0 && sectionStarts.indexOf(currentLabel) === -1) {
    var prev = CHALLENGE_SEQUENCE[idx - 1];
    leftGroup.appendChild(mkNavBtn("\u2190 " + prev.label, prev.fn, false));
  }

  // "(A AND B) OR A" and "(NOT A) AND (NOT B)" both end their respective
  // sections — show "Back to Menu" rather than continuing to the next section
  var menuEndpoints = ["(A AND B) OR A", "(NOT A) AND (NOT B)"];
  if (menuEndpoints.indexOf(currentLabel) !== -1) {
    rightGroup.appendChild(mkNavBtn("\u2302 Back to menu", showLanding, true));
  } else if (idx < CHALLENGE_SEQUENCE.length - 1) {
    var next = CHALLENGE_SEQUENCE[idx + 1];
    rightGroup.appendChild(mkNavBtn(next.label + " \u2192", next.fn, true));
  }

  wrap.appendChild(leftGroup);
  wrap.appendChild(rightGroup);
  return wrap;
}

