      var start = inp.selectionStart !== undefined ? inp.selectionStart : cur.length;
      var end   = inp.selectionEnd   !== undefined ? inp.selectionEnd   : cur.length;
      var before = cur.slice(0, start);
      var isOp = ["AND","OR","NOT"].indexOf(token) !== -1;
      var isVar = q.vars.indexOf(token) !== -1;
      var prefix = (before.length > 0 && !/[\s(]$/.test(before)) ? " " : "";
      var suffix = (isOp || token === "(") ? " " : "";
      if (token === ")") { prefix = ""; suffix = ""; }
      var insert = prefix + token + suffix;
      inp.value = before + insert + cur.slice(end);
      inp.selectionStart = inp.selectionEnd = start + insert.length;
      inp.focus();
    });
