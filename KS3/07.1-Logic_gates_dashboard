  ["AND","OR","NOT"].forEach(function(type){var tile=document.createElement("div");tile.style.cssText="background:var(--surface2);border:0.5px solid var(--border);border-radius:8px;padding:6px 12px;cursor:grab;user-select:none;display:flex;flex-direction:column;align-items:center;gap:3px;transition:border-color 0.15s;";tile.innerHTML=_bcPalSVG(type)+'<div style="font-size:12px;color:var(--text-muted);font-family:Inter,system-ui,Segoe UI,Arial,sans-serif;">'+type+'</div>';tile.addEventListener("mouseover",function(){tile.style.borderColor="var(--accent)";});tile.addEventListener("mouseout",function(){tile.style.borderColor="var(--border)";});tile.addEventListener("pointerdown",function(e){if(finished||revealed)return;_bcStartDrag(type,e,placed,checkCols,circ,circWrap,redraw,xpAwarded);});palRow.appendChild(tile);});
  palWrap.appendChild(palRow); container.appendChild(palWrap);
  function doCheck(isFinal){var correct=0,wrong=0,newXP=0;checkCols=placed.map(function(p,i){if(!p){if(isFinal)wrong++;return isFinal?"bad":null;}if(p===circ.answers[i]){correct++;var ck=q.circKey+":"+i;if(!xpAwarded[ck]){xpAwarded[ck]=true;newXP+=5;}return"ok";}wrong++;return"bad";});if(newXP>0)J277.grantXP(newXP,"exam_build");redraw();return{correct:correct,wrong:wrong,total:circ.answers.length};}
