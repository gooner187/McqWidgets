function showBuildQuestion(key) {
  var circ = null;
  for (var _i=0;_i<BC_CIRCUITS.length;_i++) { if (BC_CIRCUITS[_i].key===key) { circ=BC_CIRCUITS[_i]; break; } }
  var circIdx = _i;

  var el = document.getElementById("toolContent");
  el.innerHTML = "";
  el.appendChild(makeTopBar("Build a circuit", "Challenge"));

  // Question counter
  var counter = document.createElement("div");
  counter.style.cssText = "font-size:0.85rem;color:var(--text-muted);font-family:Inter,system-ui,Segoe UI,Arial,sans-serif;margin-bottom:0.5rem;";
  counter.textContent = "Question " + (circIdx + 1) + " of " + BC_CIRCUITS.length;
  el.appendChild(counter);

  // Target
  var tgt = document.createElement("div");
  tgt.style.cssText = "font-size:0.9rem;font-weight:600;color:var(--text);margin-bottom:0.75rem;font-family:Inter,system-ui,Segoe UI,Arial,sans-serif;background:var(--surface2);border:0.5px solid var(--border);border-radius:8px;padding:8px 14px;display:inline-block;";
  tgt.textContent = "Build: " + circ.label;
  el.appendChild(tgt);

  // State
  var placed = circ.answers.map(function(){ return null; });
  var checkCols = null;
  var revealed = false;
  var finished = false;
  var revealSaved = null;
  var xpAwarded = {};

  // Circuit container
  var circWrap = document.createElement("div");
  circWrap.style.cssText = "background:var(--bg);border:0.5px solid var(--border);border-radius:8px;padding:1rem;margin-bottom:0.75rem;display:flex;justify-content:center;overflow-x:auto;";
  el.appendChild(circWrap);

  function redraw() {
    circWrap.innerHTML = '<svg viewBox="0 0 '+circ.svgW+' '+circ.svgH+'" width="'+circ.svgW+'" style="display:block;">'+circ.buildSVG(placed,checkCols)+'</svg>';
    var svgEl = circWrap.querySelector("svg");
    svgEl.addEventListener("click", function(e) {
      if (finished || revealed) return;
      var cur = e.target;
      while (cur && cur !== svgEl) {
        var v = cur.getAttribute ? cur.getAttribute("data-slot") : null;
        if (v !== null) {
          var idx = parseInt(v);
          if (placed[idx] !== null) { placed[idx]=null; checkCols=null; redraw(); }
          return;
        }
        cur = cur.parentElement;
      }
    });
  }

  // Palette
  var palWrap = document.createElement("div");
  palWrap.style.cssText = "margin-bottom:0.75rem;";
  var palLbl = document.createElement("div");
  palLbl.style.cssText = "font-size:12px;letter-spacing:0.08em;text-transform:uppercase;color:var(--text-muted);margin-bottom:8px;font-family:Inter,system-ui,Segoe UI,Arial,sans-serif;";
  palLbl.textContent = "Gate palette — drag a gate into a slot (click placed gate to remove)";
  palWrap.appendChild(palLbl);
  var palRow = document.createElement("div");
  palRow.style.cssText = "display:flex;gap:10px;flex-wrap:wrap;";
