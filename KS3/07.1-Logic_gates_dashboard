    b.addEventListener("click",fn); return b;
  }
  if (circIdx>0) leftNav.appendChild(mkNavBtn2("\u2190 "+BC_CIRCUITS[circIdx-1].label, function(){ showBuildQuestion(BC_CIRCUITS[circIdx-1].key); }, false));
  if (circIdx<BC_CIRCUITS.length-1) rightNav.appendChild(mkNavBtn2(BC_CIRCUITS[circIdx+1].label+" \u2192", function(){ showBuildQuestion(BC_CIRCUITS[circIdx+1].key); }, true));
  else rightNav.appendChild(mkNavBtn2("\u2302 Back to menu", showLanding, true));
  el.appendChild(navBar);

  // ── Button handlers ───────────────────────────────────────
  function doCheck(isFinal) {
    var correct=0, wrong=0, newXP=0;
    checkCols = placed.map(function(p,i) {
      if (!p) { if(isFinal) wrong++; return isFinal?"bad":null; }
      if (p===circ.answers[i]) {
        correct++;
        var ck=key+":"+i;
        if (!xpAwarded[ck]){ xpAwarded[ck]=true; newXP+=5; }
        return "ok";
      }
      wrong++; return "bad";
    });
    if (newXP>0) J277.grantXP(newXP,"build_circuit");
    redraw();
    return {correct:correct, wrong:wrong, total:circ.answers.length};
  }

  function showComplete() {
    finished=true;
    J277.grantXP(15,"build_circuit_complete");
    completionBanner.style.display="block";
    completionBanner.innerHTML="\uD83C\uDF89 <strong>Circuit built correctly!</strong>";
    feedbackEl.textContent="";
    checkBtn.disabled=true; revealBtn.disabled=true;
    finishBtn.textContent="\uD83D\uDD04 Try again";
  }

  function doReset() {
    placed=circ.answers.map(function(){return null;});
    checkCols=null; revealed=false; finished=false; revealSaved=null; xpAwarded={};
    completionBanner.style.display="none";
    feedbackEl.textContent="";
    checkBtn.disabled=false; revealBtn.disabled=false;
    finishBtn.textContent="\u2714 Finished"; revealBtn.textContent="\uD83D\uDCD6 Reveal answers";
    redraw();
  }

  checkBtn.addEventListener("click",function(){
    if (finished) return;
    if (placed.every(function(p){return !p;})){feedbackEl.textContent="Drag some gates first."; return;}
    var r=doCheck(false);
    feedbackEl.style.color=r.wrong>0?"#d6453a":"#13a52f";
    feedbackEl.textContent=r.correct+"/"+r.total+" correct"+(r.wrong===0&&r.correct===r.total?" \u2714":"");
    if (r.correct===r.total) showComplete();
  });

  finishBtn.addEventListener("click",function(){
    if (finished){doReset();return;}
    var r=doCheck(true);
    if (r.correct===r.total){showComplete();}
    else{
      feedbackEl.style.color="#d6453a";
      feedbackEl.textContent=r.correct+"/"+r.total+" — red slots need fixing.";
      finished=true; finishBtn.textContent="\uD83D\uDD04 Try again";
    }
  });

  revealBtn.addEventListener("click",function(){
    if (finished) return;
    if (!revealed) {
      revealSaved=placed.slice();
      placed=circ.answers.slice();
      checkCols=circ.answers.map(function(ans,i){ return revealSaved[i]===ans?"ok":"reveal"; });
      revealed=true; revealBtn.textContent="\uD83D\uDCD5 Hide answers";
      feedbackEl.style.color="var(--text-muted)";
      feedbackEl.textContent="Green = you had it right. Blue = revealed.";
      checkBtn.disabled=true; finishBtn.disabled=true; redraw();
    } else {
      placed=revealSaved; checkCols=null; revealed=false;
      revealBtn.textContent="\uD83D\uDCD6 Reveal answers"; feedbackEl.textContent="";
      checkBtn.disabled=false; finishBtn.disabled=false; redraw();
    }
  });

  redraw();
}

// Drag state (shared, one drag at a time)
var _bcDrag = null;

function _bcStartDrag(gateType, e, placed, checkCols, circ, circWrap, redraw, xpAwarded) {
  var ghost = document.createElement("div");
  ghost.innerHTML = _bcPalSVG(gateType);
  ghost.style.cssText = "position:fixed;pointer-events:none;z-index:9999;opacity:0.88;background:var(--surface2);border:1.5px solid var(--accent);border-radius:8px;padding:4px 8px;";
  ghost.style.left=(e.clientX-40)+"px"; ghost.style.top=(e.clientY-30)+"px";
  document.body.appendChild(ghost);
  _bcDrag={type:gateType, ghost:ghost, placed:placed, checkCols:checkCols, circ:circ, circWrap:circWrap, redraw:redraw, xpAwarded:xpAwarded};
  document.addEventListener("pointermove",_bcMove);
  document.addEventListener("pointerup",_bcEnd);
  e.preventDefault();
}

function _bcMove(e) {
  if (!_bcDrag) return;
  _bcDrag.ghost.style.left=(e.clientX-40)+"px";
  _bcDrag.ghost.style.top=(e.clientY-30)+"px";
}

function _bcEnd(e) {
  if (!_bcDrag) return;
  var d=_bcDrag; _bcDrag=null;
  document.removeEventListener("pointermove",_bcMove);
  document.removeEventListener("pointerup",_bcEnd);
  // Hide ghost for hit testing
  d.ghost.style.display="none";
  var hitEl=document.elementFromPoint(e.clientX, e.clientY);
  document.body.removeChild(d.ghost);
  // Find data-slot attribute by traversing up
  var slotIdx=null, cur=hitEl;
  while (cur) {
    var v=cur.getAttribute?cur.getAttribute("data-slot"):null;
    if (v!==null){slotIdx=parseInt(v);break;}
    cur=cur.parentElement;
  }
  if (slotIdx!==null) {
    d.placed[slotIdx]=d.type;
    d.checkCols=null;
    d.redraw();
  }
}


