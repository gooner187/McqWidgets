  function showComplete(){finished=true;banner.style.display="block";banner.innerHTML="\uD83C\uDF89 <strong>Correct!</strong>";checkBtn.disabled=true;revealBtn.disabled=true;finishBtn.textContent="\uD83D\uDD04 Try again";}
