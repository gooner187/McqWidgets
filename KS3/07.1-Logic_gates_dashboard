  var circWrap=document.createElement("div"); circWrap.style.cssText="background:var(--bg);border:0.5px solid var(--border);border-radius:8px;padding:1rem;margin-bottom:0.75rem;display:flex;justify-content:center;overflow-x:auto;"; container.appendChild(circWrap);
  function redraw(){circWrap.innerHTML='<svg viewBox="0 0 '+circ.svgW+' '+circ.svgH+'" width="'+circ.svgW+'" style="display:block;">'+circ.buildSVG(placed,checkCols)+'</svg>';var sv=circWrap.querySelector("svg");sv.addEventListener("click",function(e){if(finished||revealed)return;var cur=e.target;while(cur&&cur!==sv){var v=cur.getAttribute?cur.getAttribute("data-slot"):null;if(v!==null){var idx=parseInt(v);if(placed[idx]!==null){placed[idx]=null;checkCols=null;redraw();}return;}cur=cur.parentElement;}});}
