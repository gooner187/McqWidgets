function _bw(x1,y1,x2,y2) {
  return '<line x1="'+x1+'" y1="'+y1+'" x2="'+x2+'" y2="'+y2+'" stroke="var(--text-muted)" stroke-width="2.5"/>';
}
function _bil(x,y,txt) {
  return '<text x="'+x+'" y="'+y+'" text-anchor="end" font-family="Inter,system-ui,Segoe UI,Arial,sans-serif" font-size="12" font-weight="700" fill="var(--text)">'+txt+'</text>';
}
function _bSlotEmpty(sx,sy,sw,sh,idx) {
  var cx=sx+sw/2, cy=sy+sh/2;
  return '<rect x="'+sx+'" y="'+sy+'" width="'+sw+'" height="'+sh+
    '" rx="4" fill="var(--surface2)" stroke="var(--border)" stroke-width="1.5" stroke-dasharray="5,3"'+
    ' data-slot="'+idx+'" pointer-events="all"/>'+
    '<text x="'+cx+'" y="'+(cy+4)+'" text-anchor="middle" font-family="Inter,system-ui,Segoe UI,Arial,sans-serif" font-size="10"'+
    ' fill="var(--text-muted)" pointer-events="none">drop here</text>';
}
function _bGate(type,cx,cy,h,w,stroke,sx,sy,sw,sh,idx) {
  var c=stroke||"var(--text)", sw2=2.5, g="";
  if (type==="AND") g=drawAND(cx,cy,{h:h,w:w||h,stroke:c,strokeWidth:sw2});
  else if (type==="OR")  g=drawOR(cx,cy,{h:h,w:w||h,stroke:c,strokeWidth:sw2});
  else if (type==="NOT") g=drawNOT(cx,cy,{h:h,stroke:c,strokeWidth:sw2});
  // Transparent hit rect on top for click-to-remove and drop detection
  g+='<rect x="'+sx+'" y="'+sy+'" width="'+sw+'" height="'+sh+
    '" fill="transparent" data-slot="'+idx+'" pointer-events="all" style="cursor:pointer"/>';
  return g;
}
function _bColour(cols, i) {
  if (!cols || cols[i] === null) return null;
  if (cols[i]==="ok")     return "#13a52f";
  if (cols[i]==="bad")    return "#d6453a";
  return "var(--accent)"; // "reveal"
}

