// ── TUTORIAL ──────────────────────────────────────────────────
function showTutorial(type) {
  if (type === "COMBINED") { showCombinedTutorial(); return; }
  var el = document.getElementById("toolContent");
  el.innerHTML = "";

  var isTwoInput = (type !== "NOT");
  var inputs = { A: 0, B: 0 };

  function evaluate() {
    if (type === "AND") return inputs.A & inputs.B;
    if (type === "OR")  return inputs.A | inputs.B;
    if (type === "NOT") return inputs.A ? 0 : 1;
  }

  function getActiveRow() {
    var tt = TRUTH_TABLES[type];
    for (var i = 0; i < tt.length; i++) {
      if (tt[i][0] === inputs.A && (type === "NOT" || tt[i][1] === inputs.B)) return i;
    }
    return -1;
  }

  // Top bar
  el.appendChild(makeTopBar(type + " gate", "Tutorial"));

  // Rule
  var rule = document.createElement("div");
  rule.className = "lg-rule";
  var rules = {
    AND: "Output is <strong>1</strong> only when <strong>both</strong> inputs are 1.",
    OR:  "Output is <strong>1</strong> when <strong>at least one</strong> input is 1.",
    NOT: "Output is the <strong>opposite</strong> of the input."
  };
  rule.innerHTML = rules[type];
  el.appendChild(rule);

  // Gate area
  var gateArea = document.createElement("div");
  gateArea.className = "lg-gate-area";

  // Input column
  var inputCol = document.createElement("div");
  inputCol.className = "lg-input-col";

  // Store button refs so truth table row clicks can update them
  var inputBtns = {};

  function makeInputWrap(label, key) {
    var wrap = document.createElement("div");
    wrap.className = "lg-input-wrap";
    var lbl = document.createElement("div");
    lbl.className = "lg-input-label";
    lbl.textContent = label;
    var btn = document.createElement("button");
    btn.className = "lg-input-btn";
    btn.textContent = inputs[key];
    btn.addEventListener("click", function() {
      inputs[key] = inputs[key] ? 0 : 1;
      btn.textContent = inputs[key];
      btn.classList.toggle("on", inputs[key] === 1);
      render();
    });
    inputBtns[key] = btn;
    wrap.appendChild(lbl);
    wrap.appendChild(btn);
    return wrap;
  }

  function syncInputButtons() {
    Object.keys(inputBtns).forEach(function(key) {
      inputBtns[key].textContent = inputs[key];
      inputBtns[key].classList.toggle("on", inputs[key] === 1);
    });
  }

  inputCol.appendChild(makeInputWrap("A", "A"));
  if (isTwoInput) inputCol.appendChild(makeInputWrap("B", "B"));
  gateArea.appendChild(inputCol);

  // Gate SVG
  var svgWrap = document.createElement("div");
  var viewW = 240, viewH = 160, cx = 110, cy = 80;
  var pts = gatePoints(type, cx, cy, {});
  var wireColOn  = "#13a52f";
  var wireColOff = "var(--text-muted)";

  function gateWireCol(val) { return val ? wireColOn : wireColOff; }

  function buildSVG() {
    var q = evaluate();
    var colA = gateWireCol(inputs.A);
    var colB = gateWireCol(inputs.B);
    var colQ = gateWireCol(q);
    var gateStroke = q ? wireColOn : "var(--text)";
    var sw = 3;

    var svg = '<svg class="lg-gate-svg" viewBox="0 0 ' + viewW + ' ' + viewH + '" width="' + viewW + '">';

    // Input wire A
    svg += '<line x1="20" y1="' + pts.inputA.y + '" x2="' + pts.inputA.x + '" y2="' + pts.inputA.y +
           '" stroke="' + colA + '" stroke-width="' + sw + '"/>';
    svg += '<text x="14" y="' + (pts.inputA.y + 5) + '" text-anchor="end" font-family="Inter,system-ui,Segoe UI,Arial,sans-serif" font-size="13" font-weight="700" fill="' + colA + '">A</text>';

    // Input wire B
    if (isTwoInput) {
      svg += '<line x1="20" y1="' + pts.inputB.y + '" x2="' + pts.inputB.x + '" y2="' + pts.inputB.y +
             '" stroke="' + colB + '" stroke-width="' + sw + '"/>';
      svg += '<text x="14" y="' + (pts.inputB.y + 5) + '" text-anchor="end" font-family="Inter,system-ui,Segoe UI,Arial,sans-serif" font-size="13" font-weight="700" fill="' + colB + '">B</text>';
    }

    // Gate body
    if (type === "AND") svg += drawAND(cx, cy, {stroke: gateStroke, strokeWidth: sw});
    if (type === "OR")  svg += drawOR(cx, cy,  {stroke: gateStroke, strokeWidth: sw});
    if (type === "NOT") svg += drawNOT(cx, cy, {stroke: gateStroke, strokeWidth: sw});

    // Output wire
    svg += '<line x1="' + pts.output.x + '" y1="' + pts.output.y + '" x2="' + (viewW-30) + '" y2="' + pts.output.y +
           '" stroke="' + colQ + '" stroke-width="' + sw + '"/>';
    svg += '<text x="' + (viewW-22) + '" y="' + (pts.output.y + 5) + '" font-family="Inter,system-ui,Segoe UI,Arial,sans-serif" font-size="13" font-weight="700" fill="' + colQ + '">Q</text>';

    svg += '</svg>';
    return svg;
  }

  svgWrap.innerHTML = buildSVG();
  gateArea.appendChild(svgWrap);

  // Bulb
  var bulbWrap = document.createElement("div");
  bulbWrap.className = "lg-bulb-wrap";
  var bulbEl = document.createElement("div");
  bulbEl.className = "lg-bulb";
  bulbEl.innerHTML = bulbSVG(evaluate());
  bulbWrap.appendChild(bulbEl);
  gateArea.appendChild(bulbWrap);

  // Truth table — always visible, sits to the right of the gate
  var ttPanel = document.createElement("div");
  ttPanel.style.cssText = "border-left:0.5px solid var(--border);padding-left:1.25rem;margin-left:0.5rem;display:flex;flex-direction:column;justify-content:center;";
  var ttLbl = document.createElement("div");
  ttLbl.style.cssText = "font-size:12px;letter-spacing:0.08em;text-transform:uppercase;color:var(--text-muted);margin-bottom:6px;font-family:Inter,system-ui,Segoe UI,Arial,sans-serif;";
  ttLbl.textContent = "Truth table";
  var ttContainer = document.createElement("div");
  ttContainer.className = "lg-tt-wrap";
  ttPanel.appendChild(ttLbl);
  ttPanel.appendChild(ttContainer);
  gateArea.appendChild(ttPanel);

  el.appendChild(gateArea);

  function buildTT() {
    ttContainer.innerHTML = "";
    var activeRow = getActiveRow();
    var cols = isTwoInput ? ["A","B","Q"] : ["A","Q"];
    var rows = TRUTH_TABLES[type];
    var tbl = document.createElement("table");
    tbl.className = "lg-tt";
    var thead = document.createElement("thead");
    var hr = document.createElement("tr");
    cols.forEach(function(c) {
      var th = document.createElement("th"); th.textContent = c; hr.appendChild(th);
    });
    thead.appendChild(hr); tbl.appendChild(thead);
    var tbody = document.createElement("tbody");
    rows.forEach(function(row, i) {
      var tr = document.createElement("tr");
      if (i === activeRow) tr.className = "active";
      tr.style.cursor = "pointer";
      tr.title = "Click to set inputs to this row";
      tr.addEventListener("mouseover", function() { if (i !== getActiveRow()) tr.style.background = "rgba(57,127,196,0.06)"; });
      tr.addEventListener("mouseout",  function() { if (i !== getActiveRow()) tr.style.background = ""; });
      tr.addEventListener("click", function() {
        inputs.A = row[0];
        if (isTwoInput) inputs.B = row[1];
        syncInputButtons();
        render();
      });
      row.forEach(function(v) {
        var td = document.createElement("td"); td.textContent = v; tr.appendChild(td);
      });
      tbody.appendChild(tr);
    });
    tbl.appendChild(tbody);
    ttContainer.appendChild(tbl);

    // Click hint — shown below the table, subtle
    var hint = document.createElement("div");
    hint.style.cssText = "font-size:12px;color:var(--text-muted);margin-top:5px;text-align:center;font-family:Inter,system-ui,Segoe UI,Arial,sans-serif;";
    hint.textContent = "\uD83D\uDC46 Click a row to explore";
    ttContainer.appendChild(hint);
  }

  buildTT();

  function render() {
    var q = evaluate();
    bulbEl.className = "lg-bulb" + (q ? " on" : "");
    bulbEl.innerHTML = bulbSVG(q);
    svgWrap.innerHTML = buildSVG();
    buildTT();
  }

  el.appendChild(makeTutorialNavBar(type + " gate"));
}
function showCombinedTutorial() {
  var el = document.getElementById("toolContent");
  el.innerHTML = "";
  el.appendChild(makeTopBar("Combined circuits", "Tutorial"));

  var desc = document.createElement("p");
