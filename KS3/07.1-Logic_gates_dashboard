// ── Q12 circuit MCQ ────────────────────────────────────────
function _eqQ12SVGs(){
  var s="var(--text)",sw=2;
  function optA(){ // AND → NOT (wrong)
    var c="";
    c+='<line x1="18" y1="36" x2="62" y2="36" stroke="'+s+'" stroke-width="'+sw+'"/>';
    c+='<text x="15" y="40" text-anchor="end" font-size="11" font-family="Inter,system-ui,Segoe UI,Arial,sans-serif" fill="'+s+'">A</text>';
    c+='<line x1="18" y1="54" x2="62" y2="54" stroke="'+s+'" stroke-width="'+sw+'"/>';
    c+='<text x="15" y="58" text-anchor="end" font-size="11" font-family="Inter,system-ui,Segoe UI,Arial,sans-serif" fill="'+s+'">B</text>';
    c+=drawAND(82,45,{h:36,w:40,stroke:s,strokeWidth:sw});
    c+='<line x1="120" y1="45" x2="139" y2="45" stroke="'+s+'" stroke-width="'+sw+'"/>';
    c+=drawNOT(155,45,{h:28,stroke:s,strokeWidth:sw});
    c+='<line x1="182" y1="45" x2="197" y2="45" stroke="'+s+'" stroke-width="'+sw+'"/>';
    c+='<text x="199" y="49" font-size="11" font-family="Inter,system-ui,Segoe UI,Arial,sans-serif" fill="var(--text-muted)">P</text>';
    return '<svg viewBox="0 0 215 90" width="198">'+c+'</svg>';
  }
  function optB(){ // OR → NOT (correct)
    var c="";
    c+='<line x1="18" y1="36" x2="58" y2="36" stroke="'+s+'" stroke-width="'+sw+'"/>';
    c+='<text x="15" y="40" text-anchor="end" font-size="11" font-family="Inter,system-ui,Segoe UI,Arial,sans-serif" fill="'+s+'">A</text>';
    c+='<line x1="18" y1="54" x2="58" y2="54" stroke="'+s+'" stroke-width="'+sw+'"/>';
    c+='<text x="15" y="58" text-anchor="end" font-size="11" font-family="Inter,system-ui,Segoe UI,Arial,sans-serif" fill="'+s+'">B</text>';
    c+=drawOR(80,45,{h:36,w:44,stroke:s,strokeWidth:sw});
    c+='<line x1="102" y1="45" x2="132" y2="45" stroke="'+s+'" stroke-width="'+sw+'"/>';
    c+=drawNOT(148,45,{h:28,stroke:s,strokeWidth:sw});
    c+='<line x1="175" y1="45" x2="190" y2="45" stroke="'+s+'" stroke-width="'+sw+'"/>';
    c+='<text x="192" y="49" font-size="11" font-family="Inter,system-ui,Segoe UI,Arial,sans-serif" fill="var(--text-muted)">P</text>';
    return '<svg viewBox="0 0 208 90" width="192">'+c+'</svg>';
  }
  function optC(){ // NOT A, NOT B → AND (De Morgan trap)
    var c="";
    c+='<line x1="18" y1="30" x2="38" y2="30" stroke="'+s+'" stroke-width="'+sw+'"/>';
    c+='<text x="15" y="34" text-anchor="end" font-size="11" font-family="Inter,system-ui,Segoe UI,Arial,sans-serif" fill="'+s+'">A</text>';
    c+=drawNOT(52,30,{h:26,stroke:s,strokeWidth:sw});
    c+='<line x1="78" y1="30" x2="92" y2="30" stroke="'+s+'" stroke-width="'+sw+'"/>';
    c+='<line x1="18" y1="60" x2="38" y2="60" stroke="'+s+'" stroke-width="'+sw+'"/>';
    c+='<text x="15" y="64" text-anchor="end" font-size="11" font-family="Inter,system-ui,Segoe UI,Arial,sans-serif" fill="'+s+'">B</text>';
    c+=drawNOT(52,60,{h:26,stroke:s,strokeWidth:sw});
    c+='<line x1="78" y1="60" x2="92" y2="60" stroke="'+s+'" stroke-width="'+sw+'"/>';
    c+=drawAND(115,45,{h:60,w:46,stroke:s,strokeWidth:sw});
    // AND rightX = 115+23+30 = 168
    c+='<line x1="168" y1="45" x2="183" y2="45" stroke="'+s+'" stroke-width="'+sw+'"/>';
    c+='<text x="185" y="49" font-size="11" font-family="Inter,system-ui,Segoe UI,Arial,sans-serif" fill="var(--text-muted)">P</text>';
    return '<svg viewBox="0 0 200 90" width="185">'+c+'</svg>';
  }
  return [optA(),optB(),optC()];
}

