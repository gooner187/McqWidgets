// ── Shuffle helper ────────────────────────────────────────────
function shuffle(arr) {
  var a = arr.slice();
  for (var i = a.length - 1; i > 0; i--) {
    var j = Math.floor(Math.random() * (i + 1));
    var tmp = a[i]; a[i] = a[j]; a[j] = tmp;
  }
  return a;
}

// ── Main challenge controller ─────────────────────────────────
function showIdentifyChallenge() {
  var el = document.getElementById("toolContent");
  el.innerHTML = "";
  el.appendChild(makeTopBar("Identify the circuit", "Challenge — 10 questions"));

  // Build shuffled options for each question once, upfront
  var questionData = IDENTIFY_QUESTIONS.map(function(q) {
    var opts = shuffle([q.correct].concat(q.distractors));
    return { q: q, opts: opts, chosen: null };
  });

  var currentQ = 0;

  // Container for question content — rebuilt each question
  var qArea = document.createElement("div");
  el.appendChild(qArea);

  function renderQuestion(idx) {
    qArea.innerHTML = "";
    var data = questionData[idx];
    var q = data.q;

    // Progress indicator
    var progress = document.createElement("div");
    progress.style.cssText = "font-size:0.85rem;color:var(--text-muted);font-family:Inter,system-ui,Segoe UI,Arial,sans-serif;margin-bottom:0.75rem;";
    progress.textContent = "Question " + (idx+1) + " of " + IDENTIFY_QUESTIONS.length;
    qArea.appendChild(progress);

    // Circuit diagram
    var diagramWrap = document.createElement("div");
    diagramWrap.style.cssText = "background:var(--bg);border:0.5px solid var(--border);border-radius:8px;padding:1rem;margin-bottom:1rem;display:flex;justify-content:center;";
    diagramWrap.innerHTML = q.buildSVG();
    qArea.appendChild(diagramWrap);

    // Instruction
    var instr = document.createElement("div");
    instr.style.cssText = "font-size:0.82rem;color:var(--text-muted);margin-bottom:0.75rem;font-family:Inter,system-ui,Segoe UI,Arial,sans-serif;";
    instr.textContent = "Which Boolean expression matches this circuit?";
    qArea.appendChild(instr);

    // Answer options
    var optGrid = document.createElement("div");
    optGrid.style.cssText = "display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:1rem;";

    data.opts.forEach(function(opt) {
      var btn = document.createElement("button");
      btn.textContent = opt;
      var isSelected = (data.chosen === opt);
      btn.style.cssText = "font-size:0.82rem;font-family:Inter,system-ui,Segoe UI,Arial,sans-serif;padding:10px 14px;border-radius:8px;cursor:pointer;text-align:left;border:1.5px solid " +
        (isSelected ? "var(--accent)" : "var(--border)") + ";background:" +
        (isSelected ? "rgba(57,127,196,0.15)" : "var(--surface2)") + ";color:" +
        (isSelected ? "var(--accent)" : "var(--text)") + ";transition:all 0.15s;";
      btn.addEventListener("mouseover", function() {
        if (data.chosen !== opt) { btn.style.borderColor="var(--accent)"; btn.style.background="rgba(57,127,196,0.06)"; }
      });
      btn.addEventListener("mouseout", function() {
        if (data.chosen !== opt) { btn.style.borderColor="var(--border)"; btn.style.background="var(--surface2)"; }
      });
      btn.addEventListener("click", function() {
        data.chosen = opt;
        renderQuestion(idx); // re-render to show selection
      });
      optGrid.appendChild(btn);
    });
    qArea.appendChild(optGrid);

    // Nav button
    var navRow = document.createElement("div");
    navRow.style.cssText = "display:flex;justify-content:flex-end;";
    var isLast = (idx === IDENTIFY_QUESTIONS.length - 1);
    var navBtn = document.createElement("button");
    navBtn.textContent = isLast ? "Submit answers \u2192" : "Next question \u2192";
    navBtn.disabled = !data.chosen;
    navBtn.style.cssText = "font-size:0.82rem;font-family:Inter,system-ui,Segoe UI,Arial,sans-serif;padding:8px 18px;border-radius:8px;cursor:pointer;border:0.5px solid var(--accent);background:rgba(57,127,196,0.15);color:var(--accent);opacity:" + (data.chosen ? "1" : "0.4") + ";";
    navBtn.addEventListener("click", function() {
      if (isLast) { showResults(); }
      else { currentQ++; renderQuestion(currentQ); }
    });
    navRow.appendChild(navBtn);
    qArea.appendChild(navRow);
  }

  function showResults() {
    qArea.innerHTML = "";

    var correct = questionData.filter(function(d){ return d.chosen === d.q.correct; }).length;
    var pct = Math.round((correct / IDENTIFY_QUESTIONS.length) * 100);

    // Award XP
    J277.grantXP(correct * 3, "identify_circuit");
    if (pct === 100) J277.grantXP(20, "identify_circuit_perfect");

    // Score banner
    var banner = document.createElement("div");
    var col = pct >= 80 ? "#13a52f" : pct >= 50 ? "#e6a800" : "#d6453a";
    banner.style.cssText = "text-align:center;padding:1.25rem;border-radius:10px;border:0.5px solid "+col+";background:rgba(0,0,0,0.2);margin-bottom:1.25rem;";
    banner.innerHTML = "<div style='font-size:2rem;font-weight:700;color:"+col+";font-family:Inter,system-ui,Segoe UI,Arial,sans-serif;'>"+pct+"%</div>" +
      "<div style='font-size:0.85rem;color:var(--text-muted);margin-top:4px;font-family:Inter,system-ui,Segoe UI,Arial,sans-serif;'>"+correct+" / "+IDENTIFY_QUESTIONS.length+" correct</div>";
    qArea.appendChild(banner);

    // Per-question review
    questionData.forEach(function(data, i) {
      var wasCorrect = data.chosen === data.q.correct;
      var block = document.createElement("div");
      block.style.cssText = "margin-bottom:1rem;padding:0.75rem 1rem;border-radius:8px;border:0.5px solid var(--border);background:var(--surface2);";

      // Question label + circuit
      var qlbl = document.createElement("div");
      qlbl.style.cssText = "font-size:0.85rem;color:var(--text-muted);font-family:Inter,system-ui,Segoe UI,Arial,sans-serif;margin-bottom:0.5rem;";
      qlbl.textContent = "Question " + (i+1);
      block.appendChild(qlbl);

      var diag = document.createElement("div");
      diag.style.cssText = "margin-bottom:0.75rem;";
      diag.innerHTML = data.q.buildSVG();
      block.appendChild(diag);

      // Answer display
      if (wasCorrect) {
        var ans = document.createElement("div");
        ans.style.cssText = "font-size:0.82rem;font-family:Inter,system-ui,Segoe UI,Arial,sans-serif;padding:8px 12px;border-radius:6px;border:1.5px solid #13a52f;background:rgba(19,165,47,0.12);color:#13a52f;";
        ans.innerHTML = "\u2714 " + data.chosen;
        block.appendChild(ans);
      } else {
        var wrong = document.createElement("div");
        wrong.style.cssText = "font-size:0.82rem;font-family:Inter,system-ui,Segoe UI,Arial,sans-serif;padding:8px 12px;border-radius:6px;border:1.5px solid #d6453a;background:rgba(214,69,58,0.1);color:#d6453a;margin-bottom:6px;";
        wrong.innerHTML = "\u2718 " + (data.chosen || "No answer selected");
        block.appendChild(wrong);
        var right = document.createElement("div");
        right.style.cssText = "font-size:0.82rem;font-family:Inter,system-ui,Segoe UI,Arial,sans-serif;padding:8px 12px;border-radius:6px;border:1.5px solid #13a52f;background:rgba(19,165,47,0.12);color:#13a52f;";
        right.innerHTML = "\u2714 " + data.q.correct;
        block.appendChild(right);
      }

      qArea.appendChild(block);
    });

    // Try again / back to menu buttons
    var btnRow = document.createElement("div");
    btnRow.style.cssText = "display:flex;gap:8px;margin-top:1rem;";
    var retryBtn = document.createElement("button");
    retryBtn.textContent = "\uD83D\uDD04 Try again";
    retryBtn.style.cssText = "font-size:0.82rem;font-family:Inter,system-ui,Segoe UI,Arial,sans-serif;padding:8px 16px;border-radius:8px;cursor:pointer;border:0.5px solid var(--accent);background:rgba(57,127,196,0.12);color:var(--accent);";
    retryBtn.addEventListener("click", showIdentifyChallenge);
    var menuBtn2 = document.createElement("button");
    menuBtn2.textContent = "\u2302 Back to menu";
    menuBtn2.style.cssText = "font-size:0.82rem;font-family:Inter,system-ui,Segoe UI,Arial,sans-serif;padding:8px 16px;border-radius:8px;cursor:pointer;border:0.5px solid var(--border);background:transparent;color:var(--text-muted);";
    menuBtn2.addEventListener("click", showLanding);
    btnRow.appendChild(retryBtn);
    btnRow.appendChild(menuBtn2);
    qArea.appendChild(btnRow);
  }

  renderQuestion(0);
}

