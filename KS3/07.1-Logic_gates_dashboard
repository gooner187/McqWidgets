.lg-cats>*{min-width:0}
@media(max-width:440px){.lg-btn .gi,.lg-btn .gi svg{width:40px;height:28px}.lg-btn{font-size:13px;gap:7px;padding:6px 8px}}
.lg-btn{display:flex;align-items:center;gap:10px;font-size:14px;font-weight:700;padding:7px 10px;border-radius:10px;border:2px solid #d3e1f1;background:#f6faff;color:#123252;cursor:pointer;text-align:left;min-height:52px}
.lg-btn .gi{width:52px;height:34px;flex:none;display:grid;place-items:center;font-size:22px}
.lg-btn .gi svg{width:52px;height:34px;display:block}
