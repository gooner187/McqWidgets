/* ---- video: why it kept resetting, and what actually fixes it ----
   renderVideoBlock() used to return the video markup as a string, baked
   straight into the big innerHTML rebuild on every render() call. That
   destroyed and recreated the <iframe> on every interaction, which
   resets YouTube playback to 0:00 even though nothing about the video
   changed.

   Attempt 2: keep ONE real iframe DOM node alive in a module-level
   variable and move it into a placeholder anchor via appendChild after
   each render. A test confirming the SAME node survived every render
   passed, but the video still reset in real use.

   Attempt 3: suspected the problem was app.innerHTML briefly
   disconnecting that node before the later appendChild reconnected it,
   so tried "parking" the host in a permanent element first (so it's
   supposedly never disconnected), moving it there and back via
   appendChild each render.

   Neither attempt actually works, and direct testing shows why: in
   Chromium, moving an iframe to a different parent via appendChild
   reloads it — every time, unconditionally — even when both the old and
   new parents are already connected to the document and stay connected
   the whole time. There is no "safe" way to reparent a live iframe via
   ordinary DOM moves; the move itself is what triggers the reload, not
   disconnection.

   The only fix that actually works: never move the iframe AT ALL, ever,
   after its first insertion. #videoSlot (created once, in the #app
   skeleton above) is a permanent fixed slot that always sits in the
   same place in the page — right after the header, before the body
   content — on every screen. ensureVideoHost() creates the host div
   (with its iframe) exactly once and appends it into #videoSlot exactly
   once, guarded so it can never run a second time. syncVideoHost() then
   only ever toggles #videoSlot's visibility and updates the toggle
   button / collapse state in place — plain attribute and style changes,
   never a DOM move — so the iframe's browsing context, and playback,
   are left completely alone. */
var videoHostEl = null;
function ensureVideoHost(){
  if (videoHostEl || !quiz.videoUrl) return videoHostEl;
  videoHostEl = document.createElement("div");
  videoHostEl.className = "video-host";
  videoHostEl.innerHTML =
    '<button class="video-toggle mono" data-action="toggle-video" id="videoToggleBtn"></button>' +
    '<div class="video-wrap video-collapsible" id="videoCollapseWrap">' +
      '<div class="video-frame"><iframe src="' + quiz.videoUrl + '?cc_load_policy=1" title="Quiz companion video" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe></div>' +
    '</div>';
  videoSlot.appendChild(videoHostEl); // the ONE and ONLY time this node is ever inserted anywhere
  return videoHostEl;
}
function syncVideoHost(){
  if (!quiz.videoUrl || state.screen !== "question"){
    videoSlot.style.display = "none";
    return;
  }
  var host = ensureVideoHost();
  videoSlot.style.display = "block";
  var open = state.videoOpen;
  host.querySelector("#videoToggleBtn").innerHTML = chevronSvg(open) + (open ? "Hide video" : "Watch video");
  var wrap = host.querySelector("#videoCollapseWrap");
  wrap.classList.toggle("collapsed", !open);
  wrap.style.maxHeight = window.innerWidth <= 480 ? (open ? "210px" : "0px") : "400px";
}

/* ---- perfect-score badge ----
   Drawn onto a hidden <canvas> and copied into a real <img> via
   toDataURL(), rather than built as SVG/HTML — a plain <img> is what gets
   the browser's native "Copy image" / "Save image as" context-menu entries
   (and long-press-save on phones) for free, which is the actual point:
   Andy wants pupils to be able to easily lift this out of the quiz and
   paste it elsewhere. Regenerated on every render() call (cheap — it's
   only ever present at all on the results screen with a 100% score), so
   no persistence trickery is needed here the way the video iframe needed. */
function syncCompletionBadge(){
  var canvas = document.getElementById("badgeCanvas");
  var img = document.getElementById("badgeImg");
  if (!canvas || !img) return; // not on the results screen, or not 100%
  drawCompletionBadge(canvas, quiz.title);
  img.src = canvas.toDataURL("image/png");
}

function drawCompletionBadge(canvas, title){
  var W = 640, H = 420, DPR = 2; // draw at 2x for a crisp saved/pasted image
  canvas.width = W * DPR;
  canvas.height = H * DPR;
  var ctx = canvas.getContext("2d");
  ctx.setTransform(DPR, 0, 0, DPR, 0, 0);
  ctx.clearRect(0, 0, W, H); // transparent background — pastes cleanly onto anything

  var cx = W / 2, cy = 148, r = 96;

  function ribbonTail(sign){
    // Tails peek out just below the title banner (by1=350) rather than
    // running all the way down to where the "PERFECT SCORE" caption sits
    // (by1+24=374) — otherwise the gold tail tips visually collide with
    // that letter-spaced caption text and make it hard to read.
    var tailBottom = cy + r + 112; // ~356, a few px clear of by1 (350)
    ctx.beginPath();
    ctx.moveTo(cx + sign * 14, cy + r - 22);
    ctx.lineTo(cx + sign * 62, tailBottom);
    ctx.lineTo(cx + sign * 34, tailBottom);
    ctx.lineTo(cx + sign * 2, cy + r - 4);
    ctx.closePath();
    var g = ctx.createLinearGradient(cx, cy, cx + sign * 62, tailBottom);
    g.addColorStop(0, "#E4AE33");
    g.addColorStop(1, "#A9750E");
    ctx.fillStyle = g;
    ctx.fill();
  }
  ribbonTail(-1);
  ribbonTail(1);

  // medal disc
  ctx.beginPath();
  ctx.arc(cx, cy, r, 0, Math.PI * 2);
  var mg = ctx.createRadialGradient(cx - r * 0.35, cy - r * 0.4, r * 0.1, cx, cy, r);
  mg.addColorStop(0, "#FFF7DE");
  mg.addColorStop(0.45, "#FFD966");
  mg.addColorStop(0.8, "#E3AC1C");
  mg.addColorStop(1, "#B9860E");
  ctx.fillStyle = mg;
  ctx.fill();
  ctx.lineWidth = 6;
  ctx.strokeStyle = "#8A6407";
  ctx.stroke();

  // inner bevel ring
  ctx.beginPath();
  ctx.arc(cx, cy, r - 12, 0, Math.PI * 2);
  ctx.lineWidth = 2;
  ctx.strokeStyle = "rgba(255,255,255,0.55)";
  ctx.stroke();

  drawStar(ctx, cx, cy - 44, 8, 20, 5, "#FFFDF2", "#9C6F08");

  ctx.textAlign = "center";
  ctx.textBaseline = "middle";
  ctx.font = "700 21px 'Space Mono', monospace";
  ctx.fillStyle = "#5C3F04";
  ctx.fillText("GCSECS.COM", cx, cy + 4);
  ctx.font = "700 26px 'Space Mono', monospace";
  ctx.fillStyle = "#6B4A05";
  ctx.fillText("100%", cx, cy + 40);

  // ribbon banner (hexagon: rectangle with pointed notched ends)
  var bx0 = 56, bx1 = W - 56, by0 = 284, by1 = 350, notch = 22, bmid = (by0 + by1) / 2;
  ctx.beginPath();
  ctx.moveTo(bx0 + notch, by0);
  ctx.lineTo(bx1 - notch, by0);
  ctx.lineTo(bx1, bmid);
  ctx.lineTo(bx1 - notch, by1);
  ctx.lineTo(bx0 + notch, by1);
  ctx.lineTo(bx0, bmid);
  ctx.closePath();
  var bg = ctx.createLinearGradient(0, by0, 0, by1);
  bg.addColorStop(0, "#F3C346");
  bg.addColorStop(1, "#C9971C");
  ctx.fillStyle = bg;
  ctx.fill();
  ctx.lineWidth = 2;
  ctx.strokeStyle = "#8A6407";
  ctx.stroke();

  // quiz title, shrunk to fit the banner on one line
  var maxTextWidth = (bx1 - notch) - (bx0 + notch) - 28;
  var size = 25;
  var font;
  do {
    font = "700 " + size + "px 'Space Mono', monospace";
    ctx.font = font;
    size -= 1;
  } while (ctx.measureText(title).width > maxTextWidth && size > 12);
  ctx.fillStyle = "#3E2A00";
  ctx.fillText(title, cx, bmid + 1);

  ctx.font = "600 12px 'Space Mono', monospace";
  ctx.fillStyle = "#8A6407";
  ctx.fillText("P E R F E C T   S C O R E", cx, by1 + 24);
}

function drawStar(ctx, cx, cy, innerR, outerR, points, fill, stroke){
  ctx.save();
  ctx.beginPath();
  for (var i = 0; i < points * 2; i++){
    var rr = i % 2 === 0 ? outerR : innerR;
    var a = (Math.PI / points) * i - Math.PI / 2;
    var x = cx + Math.cos(a) * rr, y = cy + Math.sin(a) * rr;
    if (i === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y);
  }
  ctx.closePath();
  ctx.fillStyle = fill;
  ctx.fill();
  ctx.lineWidth = 1.5;
  ctx.strokeStyle = stroke;
  ctx.stroke();
  ctx.restore();
}

function renderTitleScreen(){
