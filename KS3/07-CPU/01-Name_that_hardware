/* ============================================================
   PARSER — implements the plain-text grammar from the spec.
   Malformed questions are isolated (flagged, not dropped),
   so one bad edit doesn't break the whole quiz. This same
   parser is what the converter tool's preview should share,
   per Architecture in the spec.
   ============================================================ */
function parseQuiz(text){
  var lines = text.replace(/\r\n/g, "\n").split("\n");
  var i = 0;
  var title = null, videoUrl = null;
  while (i < lines.length && lines[i].trim() !== "") {
    var line = lines[i].trim();
    var mTitle = line.match(/^TITLE:\s*(.+)$/i);
    var mVideo = line.match(/^VIDEO:\s*(.+)$/i);
    if (mTitle) title = mTitle[1].trim();
    else if (mVideo) videoUrl = normalizeYouTubeUrl(mVideo[1].trim());
    i++;
  }
  while (i < lines.length && lines[i].trim() === "") i++;

  var blocks = [];
  var current = [];
  for (; i < lines.length; i++){
    if (lines[i].trim() === ""){
      if (current.length){ blocks.push(current); current = []; }
    } else {
      current.push(lines[i]);
    }
  }
  if (current.length) blocks.push(current);

  var questions = blocks.map(function(block, idx){
    return parseQuestionBlock(block, idx);
  });

  return {
    title: title || "Untitled quiz",
    videoUrl: videoUrl || null,
    questions: questions
  };
}

/* Authors will naturally paste whatever URL YouTube gives them when they
   hit Share (a normal watch/youtu.be link, sometimes with tracking params
   tacked on) rather than hand-build an /embed/ URL. A raw watch URL can't
   be framed (YouTube blocks it), so normalise anything recognisable down
   to the video ID and rebuild a proper embed URL. Anything unrecognised
   is passed through as-is rather than dropped, so a non-YouTube embed URL
   still works. */
function normalizeYouTubeUrl(url){
  if (!url) return url;
  var m = url.match(/[?&]v=([A-Za-z0-9_-]{6,})/) ||
          url.match(/youtu\.be\/([A-Za-z0-9_-]{6,})/) ||
          url.match(/youtube\.com\/embed\/([A-Za-z0-9_-]{6,})/) ||
          url.match(/youtube\.com\/shorts\/([A-Za-z0-9_-]{6,})/);
  return m ? ("https://www.youtube.com/embed/" + m[1]) : url;
}

function parseImgLine(line){
  var m = line.match(/^IMG:\s*(.+?)\s*\|\s*(.+)$/i);
  if (!m) return null;
  return { path: m[1].trim(), alt: m[2].trim() };
}

function parseQuestionBlock(block, idx){
  var lines = block.slice();
  var questionImage = null, questionImageAlt = null;

  if (lines.length && /^IMG:/i.test(lines[0].trim())){
    var img = parseImgLine(lines[0].trim());
    if (img){ questionImage = img.path; questionImageAlt = img.alt; lines = lines.slice(1); }
  }

  if (!lines.length){
    return brokenQuestion(idx, "This question has no question text.");
  }

  // A "FILL:" prefix on the question line switches this question from
  // multiple-choice to free-text: the pupil types an answer instead of
  // picking one, and every remaining line is an accepted spelling of the
  // correct answer (matched trimmed + case-insensitive) rather than a
  // shuffled set of options — so there's no right/wrong distractor list.
  var fillMatch = lines[0].trim().match(/^FILL:\s*(.+)$/i);
  var isFillBlank = !!fillMatch;
  var questionText = isFillBlank ? fillMatch[1].trim() : lines[0].trim();
  var answerLines = lines.slice(1).filter(function(l){ return l.trim() !== ""; });

  if (!answerLines.length){
    return brokenQuestion(idx, "“" + questionText + "” has no answers listed.", questionText);
  }

  if (isFillBlank){
    var acceptedBroken = false;
    var accepted = answerLines.map(function(line, i){
      var trimmed = line.trim();
      if (/^IMG:/i.test(trimmed)){ acceptedBroken = true; return null; }
      return { id: i, kind: "text", text: trimmed, correct: true };
    });
    if (acceptedBroken){
      return brokenQuestion(idx, "“" + questionText + "” is a fill-in-the-blank question but lists an image as an accepted answer — not supported.", questionText);
    }
    return {
      broken: false,
      questionText: questionText,
      questionImage: questionImage,
      questionImageAlt: questionImageAlt,
      isImageQuestion: false,
      isFillBlank: true,
      answers: accepted
    };
  }

  var answers = answerLines.map(function(line, i){
    var trimmed = line.trim();
    var img = /^IMG:/i.test(trimmed) ? parseImgLine(trimmed) : null;
    if (img){
      return { id: i, kind: "image", image: img.path, alt: img.alt, correct: i === 0 };
    }
    return { id: i, kind: "text", text: trimmed, correct: i === 0 };
  });

  var imageAnswerCount = answers.filter(function(a){ return a.kind === "image"; }).length;
  var isImageQuestion = imageAnswerCount > 0;

  if (isImageQuestion && imageAnswerCount !== answers.length){
    return brokenQuestion(idx, "“" + questionText + "” mixes image and text answers on the same option list — not supported.", questionText);
  }
  if (isImageQuestion && (answers.length < 2 || answers.length > 4)){
    return brokenQuestion(idx, "“" + questionText + "” has " + answers.length + " image answers — image questions need 2–4.", questionText);
  }
  if (!isImageQuestion && (answers.length < 2 || answers.length > 7)){
    return brokenQuestion(idx, "“" + questionText + "” has " + answers.length + " answers — text questions need 2–7.", questionText);
  }
  if (isImageQuestion){
    var missingAlt = answers.some(function(a){ return !a.alt; });
    if (missingAlt) return brokenQuestion(idx, "“" + questionText + "” is missing alt text on an image answer.", questionText);
  }
  if (questionImage && !questionImageAlt){
    return brokenQuestion(idx, "“" + questionText + "” is missing alt text on its question image.", questionText);
  }

  return {
    broken: false,
    questionText: questionText,
    questionImage: questionImage,
    questionImageAlt: questionImageAlt,
    isImageQuestion: isImageQuestion,
    isFillBlank: false,
    answers: answers
  };
}
function brokenQuestion(idx, message, questionText){
  return { broken: true, error: message, questionText: questionText || ("Question " + (idx+1)) };
}

