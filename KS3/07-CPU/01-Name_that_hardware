<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>KS3 - Name that hardware</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Mono:wght@400;700&display=swap">
<style>
  /* ============ THEME TOKENS (values verified against WCAG AA, see spec) ============ */
  body[data-theme="light"]{
    --pageBg:#F7F5F1; --text:#1F2421; --secondary:#636A78; --mutedLabel:#736E64; --wordmark:#8A8477;
    --cardBg:#FFFFFF; --cardBorder:#E5E1D8; --badgeBg:#F1EFE9; --badgeText:#636A78;
    --accent:#3B5BDB; --accentBg:#F5F7FF; --accentBadgeBg:#E8ECFC; --accentText:#3B5BDB;
    --navDoneBorder:#1F2421; --navDoneText:#1F2421; --navDoneBg:#FFFFFF;
    --navLockedBg:#EDEAE3; --navLockedText:#B5AF9F;
    --iconBg:#FFFFFF; --iconBorder:#E5E1D8; --iconColor:#1F2421;
    --correctBg:#E4F5EC; --correctText:#0F9D6C; --incorrectBg:#FCE8E6; --incorrectText:#DC2626;
  }
  body[data-theme="dark"]{
    --pageBg:#1B1D1B; --text:#F2F0EA; --secondary:#A9A79E; --mutedLabel:#8C897E; --wordmark:#8C897E;
    --cardBg:#262825; --cardBorder:#3A3C37; --badgeBg:#33352F; --badgeText:#A9A79E;
    --accent:#7C93F2; --accentBg:#2A2D45; --accentBadgeBg:#33375C; --accentText:#AAB8FA;
    --navDoneBorder:#F2F0EA; --navDoneText:#F2F0EA; --navDoneBg:#262825;
    --navLockedBg:#2E302B; --navLockedText:#65635A;
    --iconBg:#262825; --iconBorder:#3A3C37; --iconColor:#F2F0EA;
    --correctBg:#1E3A2E; --correctText:#5FD9A4; --incorrectBg:#3B2323; --incorrectText:#F28B8B;
  }
  body[data-theme="accessible"]{
    --pageBg:#FDF6E3; --text:#3B3A36; --secondary:#6B675D; --mutedLabel:#757161; --wordmark:#8A8574;
    --cardBg:#FFFBEF; --cardBorder:#E8DCC0; --badgeBg:#F3E9D2; --badgeText:#6B675D;
    --accent:#6B4A94; --accentBg:#F1EAF7; --accentBadgeBg:#E6D9F0; --accentText:#5A3D7D;
    --navDoneBorder:#3B3A36; --navDoneText:#3B3A36; --navDoneBg:#FFFBEF;
    --navLockedBg:#EFE6CE; --navLockedText:#B3A98C;
    --iconBg:#FFFBEF; --iconBorder:#E8DCC0; --iconColor:#3B3A36;
    --correctBg:#E9E4CC; --correctText:#4A5D3A; --incorrectBg:#F1DCCB; --incorrectText:#8A4A2E;
  }
  body[data-theme="ocean"]{
    --pageBg:#F3F6FB; --text:#182233; --secondary:#5C6B84; --mutedLabel:#656F7F; --wordmark:#8A97AC;
    --cardBg:#FFFFFF; --cardBorder:#DCE4F0; --badgeBg:#EAF0FA; --badgeText:#5C6B84;
    --accent:#1D6FE0; --accentBg:#E9F1FE; --accentBadgeBg:#D6E7FD; --accentText:#1B67D2;
    --navDoneBorder:#182233; --navDoneText:#182233; --navDoneBg:#FFFFFF;
    --navLockedBg:#E4EAF3; --navLockedText:#A8B4C7;
    --iconBg:#FFFFFF; --iconBorder:#DCE4F0; --iconColor:#182233;
    --correctBg:#E1F3EC; --correctText:#0F9D6C; --incorrectBg:#FCE8E6; --incorrectText:#DC2626;
  }
  body[data-theme="forest"]{
    --pageBg:#F2F8F6; --text:#122420; --secondary:#4E6A61; --mutedLabel:#5D766E; --wordmark:#7FA096;
    --cardBg:#FFFFFF; --cardBorder:#D8EAE3; --badgeBg:#E6F3EE; --badgeText:#4E6A61;
    --accent:#0E8F72; --accentBg:#E4F5EF; --accentBadgeBg:#CFEEE3; --accentText:#0A7D62;
    --navDoneBorder:#122420; --navDoneText:#122420; --navDoneBg:#FFFFFF;
    --navLockedBg:#DEEEE7; --navLockedText:#9BBBB0;
    --iconBg:#FFFFFF; --iconBorder:#D8EAE3; --iconColor:#122420;
    --correctBg:#DCEFE6; --correctText:#0E8F72; --incorrectBg:#FCE8E6; --incorrectText:#DC2626;
  }
  body[data-theme="plum"]{
    --pageBg:#F7F2FA; --text:#28183A; --secondary:#6F5C82; --mutedLabel:#796A88; --wordmark:#9987AD;
    --cardBg:#FFFFFF; --cardBorder:#E7DAF0; --badgeBg:#F1E7F7; --badgeText:#6F5C82;
    --accent:#8034C2; --accentBg:#F1E6FA; --accentBadgeBg:#E4D0F5; --accentText:#8034C2;
    --navDoneBorder:#28183A; --navDoneText:#28183A; --navDoneBg:#FFFFFF;
    --navLockedBg:#EBDFF3; --navLockedText:#B49FC6;
    --iconBg:#FFFFFF; --iconBorder:#E7DAF0; --iconColor:#28183A;
    --correctBg:#E7E0F2; --correctText:#5A3D7D; --incorrectBg:#FCE8E6; --incorrectText:#DC2626;
  }

  body[data-fontsize="normal"]{ --qSize:21px; --qLine:1.45; --aSize:15.5px; --badgeSize:13px; --btnPad:16px 18px; }
  body[data-fontsize="larger"]{ --qSize:24px; --qLine:1.45; --aSize:17.5px; --badgeSize:14px; --btnPad:18px 18px; }
  body[data-fontsize="largest"]{ --qSize:27px; --qLine:1.4; --aSize:19.5px; --badgeSize:15px; --btnPad:20px 18px; }

  * { box-sizing: border-box; }
  html,body{ margin:0; padding:0; }
  body{
    font-family:'DM Sans',system-ui,sans-serif;
    background: var(--pageBg);
    color: var(--text);
    transition: background 0.15s ease, color 0.15s ease;
  }
  button{ font-family:inherit; }
  #app{ width:100%; max-width:640px; margin:0 auto; position:relative; overflow:hidden; }
  .mono{ font-family:'Space Mono',monospace; }

  /* ---- header ---- */
  .hdr{ display:flex; justify-content:space-between; align-items:center; padding:20px 24px; gap:8px; flex-wrap:wrap; }
  .hdr-title{ font-family:'Space Mono',monospace; font-size:12px; letter-spacing:1px; text-transform:uppercase; color:var(--wordmark); }
  .hdr-controls{ display:flex; align-items:center; gap:8px; }
  .icon-btn{ width:36px; height:36px; border-radius:999px; border:1.5px solid var(--iconBorder); background:var(--iconBg); color:var(--iconColor); display:flex; align-items:center; justify-content:center; cursor:pointer; padding:0; }
  .icon-btn:focus-visible, button:focus-visible, a:focus-visible { outline: 3px solid var(--accent); outline-offset: 2px; }
  .qbadge{ background:var(--cardBg); border:1.5px solid var(--cardBorder); border-radius:999px; padding:6px 12px; font-family:'Space Mono',monospace; font-size:12px; white-space:nowrap; }

  /* ---- title screen ---- */
  .title-wrap{ display:flex; flex-direction:column; align-items:center; text-align:center; gap:14px; padding:24px 40px 8px; }
  .eyebrow{ font-family:'Space Mono',monospace; font-size:12px; letter-spacing:1.5px; text-transform:uppercase; color:var(--accent); }
  h1.qtitle{ margin:0; font-size:34px; font-weight:700; line-height:1.15; }
  .sub{ margin:0; font-size:16px; color:var(--secondary); }
  .btn-primary{ margin-top:10px; padding:16px 44px; border-radius:999px; border:none; background:var(--accent); color:#fff; font-size:16px; font-weight:600; cursor:pointer; box-shadow:0 10px 24px rgba(59,91,219,0.28); }
  .btn-secondary{ margin-top:4px; padding:10px 26px; border-radius:999px; border:1.5px solid var(--cardBorder); background:var(--cardBg); color:var(--secondary); font-size:13.5px; font-weight:600; cursor:pointer; display:inline-flex; align-items:center; gap:7px; }
  .footer-hint{ margin:18px 40px 26px; text-align:center; font-size:13px; color:var(--mutedLabel); }
  .progress-badge{ display:inline-flex; align-items:center; gap:7px; padding:6px 14px; border-radius:999px; background:var(--badgeBg); border:1px solid var(--cardBorder); font-family:'Space Mono',monospace; font-size:12px; color:var(--secondary); }

  /* ---- consent banner ---- */
  .consent-row{ display:flex; align-items:flex-start; gap:10px; margin:22px 32px 4px; padding:12px 14px; border-radius:12px; background:var(--badgeBg); border:1px solid var(--cardBorder); text-align:left; }
  .consent-row input[type=checkbox]{ width:20px; height:20px; flex:0 0 auto; margin-top:1px; accent-color: var(--accent); }
  .consent-row label{ font-size:12.5px; line-height:1.5; color:var(--secondary); cursor:pointer; }

  /* ---- video ---- */
  .video-wrap{ padding: 0 24px; }
  .video-toggle{ display:none; align-items:center; gap:6px; background:var(--cardBg); border:1.5px solid var(--cardBorder); border-radius:999px; padding:5px 12px 5px 10px; font-size:11.5px; font-weight:600; color:var(--accent); cursor:pointer; margin: 0 24px 8px; }
  .video-frame{ width:100%; aspect-ratio:16/9; border-radius:12px; overflow:hidden; border:1.5px solid var(--cardBorder); margin-bottom:10px; }
  .video-frame iframe{ width:100%; height:100%; border:0; display:block; }
  .video-collapsible{ overflow:hidden; transition:max-height .28s ease, margin .28s ease; }

  /* ---- question screen ---- */
  .qbody{ padding: 4px 32px 0; }
  h2.qtext{ margin:20px 0 22px; font-size:var(--qSize); font-weight:600; line-height:var(--qLine); }
  .q-image-wrap{ margin:0 0 20px; border-radius:14px; overflow:hidden; border:1.5px solid var(--cardBorder); cursor:zoom-in; position:relative; }
  .q-image-wrap img{ width:100%; display:block; }
  .answers{ display:flex; flex-direction:column; gap:12px; }
  .ans-btn{ display:flex; align-items:center; gap:14px; width:100%; padding:var(--btnPad); border-radius:14px; border:2px solid var(--cardBorder); background:var(--cardBg); font-size:var(--aSize); color:var(--text); text-align:left; cursor:pointer; }
  .ans-btn.selected{ border-color:var(--accent); background:var(--accentBg); }
  .ans-btn:disabled{ cursor:default; opacity:.88; }
  .ans-badge{ flex:0 0 auto; width:26px; height:26px; border-radius:8px; background:var(--badgeBg); display:flex; align-items:center; justify-content:center; font-family:'Space Mono',monospace; font-size:var(--badgeSize); color:var(--badgeText); }
  .ans-btn.selected .ans-badge{ background:var(--accentBadgeBg); color:var(--accentText); }

  .fill-row{ display:flex; gap:10px; align-items:center; flex-wrap:wrap; }
  .fill-input{ flex:1 1 200px; min-width:160px; padding:14px 16px; border-radius:14px; border:2px solid var(--cardBorder); background:var(--cardBg); color:var(--text); font-size:var(--aSize); font-family:inherit; }
  .fill-input:focus{ outline:none; border-color:var(--accent); }
  .fill-check-btn{ margin-top:0; padding:14px 28px; white-space:nowrap; }

  .img-answers{ display:grid; grid-template-columns:1fr 1fr; gap:12px; }
  .img-ans{ position:relative; border-radius:14px; overflow:hidden; border:2px solid var(--cardBorder); background:var(--cardBg); cursor:pointer; padding:0; }
  .img-ans.selected{ border-color:var(--accent); }
  .img-ans img{ width:100%; display:block; aspect-ratio:4/3; object-fit:contain; background:var(--badgeBg); }
  .img-ans .ans-badge{ position:absolute; top:8px; left:8px; background:var(--cardBg); border:1px solid var(--cardBorder); }
  .img-zoom-btn{ position:absolute; top:8px; right:8px; width:30px; height:30px; border-radius:999px; border:1px solid var(--cardBorder); background:rgba(255,255,255,0.92); color:var(--text); display:flex; align-items:center; justify-content:center; cursor:pointer; padding:0; }
  @media (hover:hover){ .img-zoom-btn{ opacity:0; transition:opacity .15s; } .img-ans:hover .img-zoom-btn, .img-ans:focus-within .img-zoom-btn{ opacity:1; } }

  .finish-row{ margin-top:22px; display:flex; justify-content:center; }

  /* ---- nav ---- */
  .nav-section{ margin-top:26px; border-top:1px solid var(--cardBorder); padding-top:18px; }
  .nav-label{ margin:0 0 12px; font-family:'Space Mono',monospace; font-size:11px; letter-spacing:.5px; text-transform:uppercase; color:var(--mutedLabel); }
  .nav-btn{ width:44px; height:44px; border-radius:999px; font-family:'Space Mono',monospace; font-size:13px; display:flex; align-items:center; justify-content:center; padding:0; flex:0 0 44px; }
  .nav-btn.answered{ background:var(--navDoneBg); border:1.5px solid var(--navDoneBorder); color:var(--navDoneText); font-weight:600; cursor:pointer; }
  .nav-btn.current{ background:var(--accent); border:1.5px solid var(--accent); color:#fff; font-weight:700; cursor:pointer; }
  .nav-btn.locked{ background:var(--navLockedBg); border:1.5px solid var(--cardBorder); color:var(--navLockedText); cursor:not-allowed; }
  .nav-row{ display:flex; flex-wrap:wrap; gap:8px; padding-bottom:24px; }
  .nav-strip{ display:none; gap:8px; overflow-x:auto; -webkit-overflow-scrolling:touch; scroll-snap-type:x proximity; padding-bottom:24px; }
  .nav-strip .nav-btn{ scroll-snap-align:center; }
  .nav-grid-outer{ display:flex; align-items:center; gap:10px; padding-bottom:24px; }
  .nav-grid-viewport{ overflow:hidden; flex:1 1 auto; }
  .nav-grid-track{ display:flex; transition:transform .4s cubic-bezier(.65,0,.35,1); }
  .nav-grid-page{ flex:0 0 100%; box-sizing:border-box; display:grid; grid-template-columns:repeat(10,1fr); grid-auto-rows:44px; gap:8px; }
  .nav-grid-page.tight{ column-gap:3px; }
  .nav-arrow{ flex:0 0 auto; width:32px; height:96px; border-radius:12px; border:1.5px solid var(--accent); background:var(--cardBg); color:var(--accent); cursor:pointer; display:flex; align-items:center; justify-content:center; padding:0; }
  .nav-arrow:disabled{ visibility:hidden; }
  .restart-mid{ display:flex; justify-content:center; margin: 6px 0 0; }
  .restart-mid button{ background:none; border:none; color:var(--secondary); font-size:12.5px; text-decoration:underline; cursor:pointer; padding:6px; }

  /* ---- results ---- */
  .result-card{ margin:8px 32px 0; background:var(--cardBg); border:1.5px solid var(--cardBorder); border-radius:22px; padding:36px 32px; display:flex; flex-direction:column; align-items:center; gap:8px; }
  /* Perfect-score badge: a real <img> (drawn from a hidden <canvas>, see
     syncCompletionBadge) so right-click "Copy image" / "Save image as", and
     long-press-save on mobile, work exactly like any other picture. */
  .badge-score-row{ display:flex; align-items:center; justify-content:center; gap:18px; flex-wrap:wrap; width:100%; }
  .badge-wrap{ display:flex; justify-content:center; margin:0; }
  .badge-img{ max-width:170px; width:170px; height:auto; display:block; }
  .score-block{ display:flex; flex-direction:column; align-items:center; gap:2px; }
  .result-score{ font-family:'Space Mono',monospace; font-size:52px; font-weight:700; color:var(--accent); line-height:1; margin-top:4px; }
  .review-header{ display:flex; align-items:center; justify-content:center; gap:8px; margin:32px 0 16px; color:var(--mutedLabel); font-family:'Space Mono',monospace; font-size:12px; letter-spacing:.5px; text-transform:uppercase; }
  .review-list{ padding:0 32px 40px; display:flex; flex-direction:column; gap:14px; }
  .review-card{ background:var(--cardBg); border:1.5px solid var(--cardBorder); border-radius:14px; padding:16px 18px; display:flex; flex-direction:column; gap:8px; }
  .review-top{ display:flex; justify-content:space-between; align-items:flex-start; gap:12px; }
  .review-qtext{ font-size:14.5px; font-weight:500; line-height:1.4; flex:1; }
  .chip{ flex:0 0 auto; display:flex; align-items:center; gap:5px; padding:4px 10px; border-radius:999px; font-family:'Space Mono',monospace; font-size:11px; font-weight:700; }
  .chip.correct{ background:var(--correctBg); color:var(--correctText); }
  .chip.incorrect{ background:var(--incorrectBg); color:var(--incorrectText); }
  .review-answer{ font-size:13px; color:var(--secondary); }
  .review-thumbs{ display:flex; gap:20px; }
  .review-thumb-col{ display:flex; flex-direction:column; gap:6px; align-items:flex-start; }
  .review-thumb-col span{ font-family:'Space Mono',monospace; font-size:10.5px; letter-spacing:.5px; text-transform:uppercase; }
  .review-thumb{ width:72px; height:54px; border-radius:8px; object-fit:contain; background:var(--badgeBg); border:2px solid var(--cardBorder); }

  /* ---- zoom overlay ---- */
  .zoom-overlay{ position:absolute; inset:0; background:rgba(10,10,10,0.86); display:flex; align-items:center; justify-content:center; z-index:50; touch-action:none; }
  .zoom-stage{ position:relative; width:92%; height:82%; display:flex; align-items:center; justify-content:center; overflow:hidden; }
  .zoom-stage img{ max-width:100%; max-height:100%; object-fit:contain; cursor:grab; touch-action:none; user-select:none; -webkit-user-select:none; }
  .zoom-stage img.zoomed{ cursor:grab; }
  .zoom-stage img.dragging{ cursor:grabbing; }
  .zoom-toolbar{ position:absolute; top:10px; right:10px; display:flex; gap:8px; }
  .zoom-toolbar button{ width:40px; height:40px; border-radius:999px; border:none; background:rgba(255,255,255,0.14); color:#fff; display:flex; align-items:center; justify-content:center; cursor:pointer; }
  .zoom-toolbar button:hover, .zoom-toolbar button:focus-visible{ background:rgba(255,255,255,0.26); }
  .zoom-alt{ position:absolute; bottom:10px; left:0; right:0; text-align:center; color:#e8e6e0; font-size:12px; font-family:'Space Mono',monospace; padding:0 20px; }

  /* ---- error state ---- */
  .error-box{ margin:40px 32px; padding:24px; border-radius:14px; background:var(--incorrectBg); border:1.5px solid var(--incorrectText); color:var(--text); text-align:center; }
  .broken-q-note{ margin:12px 0; padding:14px; border-radius:10px; background:var(--incorrectBg); color:var(--incorrectText); font-size:13px; text-align:center; }

  /* ---- mobile (<=480px): collapsible video, split header, swipeable nav strip only ---- */
  @media (max-width:480px){
    .hdr{ flex-direction:column; align-items:stretch; gap:9px; padding:14px 16px 0; }
    .hdr-row1{ display:flex; justify-content:space-between; align-items:center; }
    .hdr-row2{ display:flex; justify-content:space-between; align-items:center; }
    .icon-btn{ width:32px; height:32px; }
    .video-toggle{ display:inline-flex; }
    .video-collapsible.collapsed{ max-height:0; margin:0; }
    .qbody{ padding:4px 18px 0; }
    .title-wrap{ padding:20px 20px 8px; }
    h1.qtitle{ font-size:28px; }
    .nav-grid-outer{ display:none; }
    .nav-row{ display:none; }
    .nav-strip{ display:flex !important; }
    /* Shrink the badge and score number a bit so they still sit side by
       side (not stacked) inside the narrower card on a phone. */
    .result-card{ padding:28px 20px; margin-left:16px; margin-right:16px; }
    .badge-score-row{ gap:10px; }
    .badge-img{ width:120px; }
    .result-score{ font-size:40px; }
  }
</style>
</head>
