          '<span class="review-answer">Your answer: ' + escapeHtml(typedAnswer) + (correct ? "" : " · Correct answer: " + escapeHtml(correctAns.text)) + '</span>' +
        '</div>'
      );
    }

    var chosen = a ? findAnswerById(q, a.id) : null;

    if (q.isImageQuestion){
      return (
        '<div class="review-card">' +
          '<div class="review-top"><span class="review-qtext">' + (idx+1) + '. ' + escapeHtml(q.questionText) + '</span>' +
            '<span class="chip ' + (correct?"correct":"incorrect") + '">' + (correct ? checkSvg() + "Correct" : xSvg() + "Incorrect") + '</span></div>' +
          (correct ? '<div class="review-thumbs"><div class="review-thumb-col"><span>Your answer</span><img class="review-thumb" src="' + resolveImage(chosen.image) + '" alt="' + escapeHtml(chosen.alt) + '"></div></div>' :
          '<div class="review-thumbs">' +
            '<div class="review-thumb-col"><span style="color:var(--incorrectText)">Your answer</span><img class="review-thumb" style="border-color:var(--incorrectText)" src="' + resolveImage(chosen.image) + '" alt="' + escapeHtml(chosen.alt) + '"></div>' +
            '<div class="review-thumb-col"><span style="color:var(--correctText)">Correct answer</span><img class="review-thumb" style="border-color:var(--correctText)" src="' + resolveImage(correctAns.image) + '" alt="' + escapeHtml(correctAns.alt) + '"></div>' +
          '</div>') +
        '</div>'
      );
    }
    return (
      '<div class="review-card">' +
        '<div class="review-top"><span class="review-qtext">' + (idx+1) + '. ' + escapeHtml(q.questionText) + '</span>' +
          '<span class="chip ' + (correct?"correct":"incorrect") + '">' + (correct ? checkSvg() + "Correct" : xSvg() + "Incorrect") + '</span></div>' +
        '<span class="review-answer">Your answer: ' + escapeHtml(chosen ? chosen.text : "—") + (correct ? "" : " · Correct answer: " + escapeHtml(correctAns.text)) + '</span>' +
      '</div>'
    );
  }).join("");

  // A canvas-drawn, downloadable/copyable "perfect score" badge — only
  // when every (non-broken) question was answered correctly. The canvas
  // itself is drawn (and turned into the <img>'s actual src) by
  // syncCompletionBadge(), called from render() after this HTML is in the
  // page — it can't be drawn inline here since canvas drawing needs a real
  // DOM element to exist first. See drawCompletionBadge() for why it's a
  // real <img>, not an SVG or styled DOM: browsers only offer "Copy image" /
  // "Save image as" on an actual <img>.
  var isPerfect = score.total > 0 && score.correct === score.total;
  var badgeHtml = isPerfect
    ? '<div class="badge-wrap"><canvas id="badgeCanvas" style="display:none;" aria-hidden="true"></canvas><img id="badgeImg" class="badge-img" alt="Perfect score badge — 100% on ' + escapeHtml(quiz.title) + '"></div>'
    : "";

  // On a perfect score, the badge sits next to the score number rather than
  // stacked above it (Andy's request, after seeing the first stacked
  // version) — same row, wraps to stacked automatically on a screen too
  // narrow to fit both side by side (see .badge-score-row).
  var scoreBlock =
    '<div class="score-block">' +
      '<div class="result-score">' + score.correct + '/' + score.total + '</div>' +
      '<span style="font-size:18px;font-weight:600;">' + pct + '%</span>' +
    '</div>';
  var topRow = badgeHtml
    ? '<div class="badge-score-row">' + badgeHtml + scoreBlock + '</div>'
    : scoreBlock;

  // On a perfect score, the card's own "Try again" is redundant right next
  // to the badge/marks (Andy's request) — the one below the review section
  // stays either way, so restarting is still always reachable.
  var cardTryAgainBtn = isPerfect
    ? ""
    : '<button class="btn-primary" data-action="restart-quiz">Try again</button>';

  return (
    '<div class="result-card">' +
      '<span class="mono" style="font-size:11px;letter-spacing:1px;text-transform:uppercase;color:var(--mutedLabel);">Quiz complete</span>' +
      topRow +
      '<span style="font-size:14px;color:var(--secondary);">' + escapeHtml(quiz.title) + '</span>' +
      cardTryAgainBtn +
    '</div>' +
    '<div class="review-header">' +
      '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>Review your answers' +
    '</div>' +
    '<div class="review-list">' + reviewCards +
      '<div style="display:flex;justify-content:center;"><button class="btn-primary" data-action="restart-quiz">Try again</button></div>' +
    '</div>'
  );
}
function findAnswerById(q, id){ return q.answers.filter(function(a){ return a.id === id; })[0]; }

/* Fill-in-the-blank: matched trimmed + case-insensitive against every
   accepted spelling in q.answers (all marked correct:true by the parser —
   there are no wrong options to pick, only right ones to type). Mirrors
   select-answer's auto-advance behaviour so the two question types feel
   the same to use. Reads straight from the DOM rather than from
   state.fillDraft so the Enter-key path and the Check-button path share
   one code path with no risk of them disagreeing. */
function submitFillAnswer(){
  var idx = state.currentIndex;
  var q = quiz.questions[idx];
  var inputEl = document.getElementById("fillInput");
  if (!inputEl) return;
  var typed = inputEl.value.trim();
  if (!typed) return;
  var normalized = typed.toLowerCase();
  var isCorrect = q.answers.some(function(a){ return a.text.trim().toLowerCase() === normalized; });
  state.answered[idx] = { text: typed, correct: isCorrect };
  delete state.fillDraft[idx];
  saveProgress();
  render();
  if (idx < quiz.questions.length - 1){
    setTimeout(function(){
      if (state.currentIndex === idx){ state.currentIndex = idx + 1; saveProgress(); render(); }
    }, 420);
  }
}
function checkSvg(){ return '<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>'; }
function xSvg(){ return '<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>'; }

function renderZoomOverlay(){
  var z = state.zoom;
  var stage2 = z.stage === 2;
  return (
    '<div class="zoom-overlay" data-action="zoom-close-backdrop">' +
      '<div class="zoom-stage" data-action="zoom-stage">' +
        '<img id="zoomImg" src="' + z.src + '" alt="' + escapeHtml(z.alt) + '" class="' + (stage2 ? "zoomed" : "") + '" style="transform: translate(' + z.tx + 'px,' + z.ty + 'px) scale(' + (stage2 ? z.scale : 1) + ');">' +
        '<div class="zoom-toolbar">' +
          '<button data-action="zoom-toggle" aria-label="' + (stage2 ? "Zoom out" : "Zoom in further") + '"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line>' + (stage2 ? "" : '<line x1="11" y1="8" x2="11" y2="14"></line><line x1="8" y1="11" x2="14" y2="11"></line>') + '</svg></button>' +
          '<button data-action="zoom-close" aria-label="Close"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg></button>' +
        '</div>' +
        '<div class="zoom-alt">' + escapeHtml(z.alt) + '</div>' +
      '</div>' +
    '</div>'
  );
}

function escapeHtml(s){
  return String(s == null ? "" : s).replace(/[&<>"']/g, function(c){
    return { "&":"&amp;", "<":"&lt;", ">":"&gt;", '"':"&quot;", "'":"&#39;" }[c];
  });
}

/* ============================================================
   ACTIONS
   ============================================================ */
app.addEventListener("click", function(e){
  var el = e.target.closest("[data-action]");
  if (!el) return;
  var action = el.getAttribute("data-action");

  if (action === "start-quiz"){ newAttempt(); state.screen = "question"; render(); }
  else if (action === "continue-quiz"){
    var p = loadProgress();
    if (p){ state.order = p.order; state.answered = p.answered; state.currentIndex = p.currentIndex; }
    state.screen = "question"; render();
  }
  else if (action === "restart-quiz"){ clearProgress(); newAttempt(); state.screen = "question"; render(); }
  else if (action === "finish-quiz"){ clearProgress(); logAttempt("completed"); state.screen = "results"; render(); }
  else if (action === "toggle-theme"){
    var order = ["light","dark","accessible","ocean","forest","plum"];
    state.theme = order[(order.indexOf(state.theme)+1) % order.length];
    localStorage.setItem("mcq_theme", state.theme); render();
  }
  else if (action === "toggle-fontsize"){
    var forder = ["normal","larger","largest"];
    state.fontSize = forder[(forder.indexOf(state.fontSize)+1) % forder.length];
    localStorage.setItem("mcq_fontsize", state.fontSize); render();
  }
  else if (action === "toggle-consent"){
    state.consent = el.checked;
    localStorage.setItem("mcq_consent", state.consent ? "1" : "0"); render();
  }
  else if (action === "toggle-video"){ state.videoOpen = !state.videoOpen; render(); }
  else if (action === "select-answer"){
    var idx = state.currentIndex;
    var q = quiz.questions[idx];
    var id = parseInt(el.getAttribute("data-id"), 10);
    var ans = findAnswerById(q, id);
    state.answered[idx] = { id: id, correct: !!ans.correct };
    saveProgress();
    render();
    // Selecting an answer always auto-advances to the next question —
    // whether it's the first time this question's been answered, or the
    // pupil jumped back via the nav to fix an earlier one. An earlier
    // version of this only auto-advanced on a question's first answer, on
    // the theory that a revisit-to-fix should leave the pupil in place —
    // but that theory was wrong in practice: e.g. answering Q3 and
    // immediately clicking nav button "2" (before Q3's own 420ms
    // auto-advance had fired) left Q3 marked "answered" without the pupil
    // ever having actually left it, so navigating back to Q3 afterwards
    // was indistinguishable from a deliberate revisit-to-fix and wrongly
    // got stuck too. Simpler and matches what's actually expected:
    // picking an answer always moves forward one question; the nav is
    // there for jumping anywhere else afterward.
    if (idx < quiz.questions.length - 1){
      setTimeout(function(){
        if (state.currentIndex === idx){ state.currentIndex = idx + 1; saveProgress(); render(); }
      }, 420);
    }
  }
  else if (action === "submit-fill"){ submitFillAnswer(); }
  else if (action === "goto-question"){
    state.currentIndex = parseInt(el.getAttribute("data-idx"), 10); render();
  }
  else if (action === "nav-page-prev"){ state.navPage = Math.max(0, state.navPage - 1); render(); }
  else if (action === "nav-page-next"){ state.navPage = state.navPage + 1; render(); }
  else if (action === "zoom-open"){
    state.zoom = { src: el.getAttribute("data-src"), alt: el.getAttribute("data-alt"), stage: 1, scale: 2.1, tx: 0, ty: 0 };
    render();
  }
  else if (action === "zoom-toggle"){
    state.zoom.stage = state.zoom.stage === 1 ? 2 : 1;
    state.zoom.tx = 0; state.zoom.ty = 0;
    render();
  }
  else if (action === "zoom-close" || action === "zoom-close-backdrop"){
    if (action === "zoom-close-backdrop" && e.target.closest(".zoom-stage") && !e.target.closest(".zoom-toolbar")) {
      // click inside the image area (not toolbar) while zoomed out just does nothing extra;
      // dragging is handled separately. Only true backdrop clicks close it.
      if (e.target.id !== undefined && el === e.target){ state.zoom = null; render(); }
      return;
    }
    state.zoom = null; render();
  }
}, false);

app.addEventListener("keydown", function(e){
  var el = e.target.closest('[data-action="zoom-open"]');
  if (el && (e.key === "Enter" || e.key === " ")){
    e.preventDefault();
    state.zoom = { src: el.getAttribute("data-src"), alt: el.getAttribute("data-alt"), stage: 1, scale: 2.1, tx: 0, ty: 0 };
    render();
  }
  if (e.key === "Escape" && state.zoom){ state.zoom = null; render(); }
  if (e.key === "Enter" && e.target.classList && e.target.classList.contains("fill-input")){
    e.preventDefault();
    submitFillAnswer();
  }
});

/* Keeps a not-yet-submitted fill-in-the-blank answer alive across a
   render() triggered by something else entirely — toggling theme or text
   size rebuilds bodySlot's innerHTML from scratch, which would otherwise
   silently wipe out whatever the pupil had half-typed. */
app.addEventListener("input", function(e){
  if (e.target.classList && e.target.classList.contains("fill-input")){
    state.fillDraft[state.currentIndex] = e.target.value;
  }
});

/* Drag-to-pan (stage 2), pointer events unify mouse + touch */
function bindZoomDrag(){
  var img = document.getElementById("zoomImg");
  if (!img || !state.zoom || state.zoom.stage !== 2) return;
  var dragging = false, startX, startY, startTx, startTy;
  var frame = img.parentElement;

  function clamp(v, min, max){ return Math.max(min, Math.min(max, v)); }
  function bounds(){
    var scale = state.zoom.scale;
    var fw = frame.clientWidth, fh = frame.clientHeight;
    var iw = img.naturalWidth || fw, ih = img.naturalHeight || fh;
    var fitScale = Math.min(fw / iw, fh / ih);
    var dispW = iw * fitScale * scale, dispH = ih * fitScale * scale;
    var maxX = Math.max(0, (dispW - fw) / 2), maxY = Math.max(0, (dispH - fh) / 2);
    return { maxX: maxX, maxY: maxY };
  }

  img.addEventListener("pointerdown", function(e){
    dragging = true; img.classList.add("dragging");
    startX = e.clientX; startY = e.clientY; startTx = state.zoom.tx; startTy = state.zoom.ty;
    img.setPointerCapture(e.pointerId);
  });
  img.addEventListener("pointermove", function(e){
    if (!dragging) return;
    var b = bounds();
    state.zoom.tx = clamp(startTx + (e.clientX - startX), -b.maxX, b.maxX);
    state.zoom.ty = clamp(startTy + (e.clientY - startY), -b.maxY, b.maxY);
    img.style.transform = "translate(" + state.zoom.tx + "px," + state.zoom.ty + "px) scale(" + state.zoom.scale + ")";
  });
  function endDrag(){ dragging = false; img.classList.remove("dragging"); }
  img.addEventListener("pointerup", endDrag);
  img.addEventListener("pointercancel", endDrag);
}

/* Cross-widget sync: theme/text-size/consent set in another
   same-origin iframe update this one immediately (spec: Multiple
   widgets on one page). */
window.addEventListener("storage", function(e){
  if (e.key === "mcq_theme" && e.newValue){ state.theme = e.newValue; render(); }
  if (e.key === "mcq_fontsize" && e.newValue){ state.fontSize = e.newValue; render(); }
  if (e.key === "mcq_consent"){ state.consent = e.newValue === "1"; render(); }
});

/* iframe auto-resize: tell the parent page our height whenever it changes */
var lastHeight = 0;
function postHeight(){
  requestAnimationFrame(function(){
    var h = document.body.scrollHeight;
    if (h !== lastHeight){
      lastHeight = h;
      try { window.parent.postMessage({ mcqWidgetHeight: h }, "*"); } catch(e){}
    }
  });
}
window.addEventListener("resize", function(){ render(); });

/* Catches height changes render() doesn't know about — most importantly
   the Google Fonts (Space Mono / DM Sans) swapping in shortly after first
   paint, which can make the page taller than what postHeight() measured
   at the initial render (a `display=swap` web font renders with a
   fallback font first, then reflows once the real one loads). Without
   this, the iframe can be left "chopped" — correct content, wrong box
   height — until something else happens to trigger a resize. That's
   exactly the failure seen live on gcsecs.com: a widget looked cut off
   until the browser's zoom level was changed, which forces the same
   resize/render/postHeight cycle this ResizeObserver now runs
   automatically instead, catching font loads, image loads, or any other
   future async content change, not just this one specific cause. */
if (window.ResizeObserver){
  new ResizeObserver(function(){ postHeight(); }).observe(document.body);
}

/* ============================================================
   BOOT
   ============================================================ */
render();

})();
</script>
</body>
