function renderNav(){
  var total = quiz.questions.length;
  var current = state.currentIndex;

  function btnClass(i){
    if (i === current) return "current";
    if (state.answered.hasOwnProperty(i)) return "answered";
    return "locked";
  }
  function btnHtml(i){
    var cls = btnClass(i);
    var clickable = cls !== "locked";
    return '<button class="nav-btn ' + cls + '" ' + (clickable ? 'data-action="goto-question" data-idx="' + i + '"' : 'disabled') + '>' + (i+1) + '</button>';
  }

  var label = '<p class="nav-label mono">Jump back to a previous question</p>';

  // Mobile: always a single swipeable strip regardless of count (CSS forces this at <=480px)
  var stripHtml = '<div class="nav-strip">' + Array.from({length: total}, function(_,i){ return btnHtml(i); }).join("") + '</div>';

  if (total <= 20){
    return '<div class="nav-section">' + label + '<div class="nav-row">' + Array.from({length: total}, function(_,i){ return btnHtml(i); }).join("") + '</div>' + stripHtml + '</div>';
  }

  // Desktop/tablet paged grid (v3: 44px fixed, gaps tighten on middle pages)
  var perPage = 20;
  var pageCount = Math.ceil(total / perPage);
  var page = Math.min(state.navPage, pageCount - 1);
  var pagesHtml = "";
  for (var p = 0; p < pageCount; p++){
    var start = p * perPage;
    var end = Math.min(start + perPage, total);
    var isMiddle = p > 0 && p < pageCount - 1;
    var btns = "";
    for (var i = start; i < end; i++) btns += btnHtml(i);
    pagesHtml += '<div class="nav-grid-page ' + (isMiddle ? "tight" : "") + '">' + btns + '</div>';
  }
  var showPrev = page > 0, showNext = page < pageCount - 1;
  return (
    '<div class="nav-section">' + label +
    '<div class="nav-grid-outer">' +
      '<button class="nav-arrow" data-action="nav-page-prev" ' + (showPrev?"":"disabled") + ' aria-label="Show earlier questions"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 6 9 12 15 18"></polyline></svg></button>' +
      '<div class="nav-grid-viewport"><div class="nav-grid-track" style="transform:translateX(-' + (page*100) + '%);width:' + (pageCount*100) + '%;">' + pagesHtml + '</div></div>' +
      '<button class="nav-arrow" data-action="nav-page-next" ' + (showNext?"":"disabled") + ' aria-label="Show later questions"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 6 15 12 9 18"></polyline></svg></button>' +
    '</div>' +
    stripHtml +
    '</div>'
  );
}

function renderResultsScreen(){
  var score = computeScore();
  var pct = score.total ? Math.round((score.correct / score.total) * 100) : 0;
  var reviewCards = quiz.questions.map(function(q, idx){
    if (q.broken) return "";
    var a = state.answered[idx];
    var correct = a && a.correct;
    var correctAns = q.answers.filter(function(x){ return x.correct; })[0];

    if (q.isFillBlank){
      var typedAnswer = a ? a.text : "—";
      return (
        '<div class="review-card">' +
          '<div class="review-top"><span class="review-qtext">' + (idx+1) + '. ' + escapeHtml(q.questionText) + '</span>' +
