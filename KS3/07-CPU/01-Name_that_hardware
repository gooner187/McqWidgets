  resumeAvailable: false,
  order: [],                  // per-question shuffled answer arrays
  answered: {},                // qIndex -> {id, correct} for MC/image, {text, correct} for fill-blank
  fillDraft: {},               // qIndex -> in-progress typed text, not yet submitted (survives theme/fontsize re-renders)
  currentIndex: 0,
  navPage: 0,
  theme: localStorage.getItem("mcq_theme") || "light",
  fontSize: localStorage.getItem("mcq_fontsize") || "normal",
  consent: localStorage.getItem("mcq_consent") === "1",
  videoOpen: false,
  zoom: null                  // {src, alt, stage, scale, tx, ty}
};

var PROGRESS_KEY = "mcq_progress_" + QUIZ_ID;

function shuffledIds(answers){
  var ids = answers.map(function(a){ return a.id; });
  for (var i = ids.length - 1; i > 0; i--){
    var j = Math.floor(Math.random() * (i + 1));
    var t = ids[i]; ids[i] = ids[j]; ids[j] = t;
  }
  return ids;
}

function newAttempt(){
  state.order = quiz.questions.map(function(q){
    return q.broken ? [] : shuffledIds(q.answers);
  });
  state.answered = {};
  state.fillDraft = {};
  state.currentIndex = 0;
  state.navPage = 0;
  saveProgress();
  logAttempt("started");
}

function saveProgress(){
  try {
    sessionStorage.setItem(PROGRESS_KEY, JSON.stringify({
      order: state.order, answered: state.answered, currentIndex: state.currentIndex
    }));
  } catch(e){}
}
function loadProgress(){
  try {
    var raw = sessionStorage.getItem(PROGRESS_KEY);
    if (!raw) return null;
    return JSON.parse(raw);
  } catch(e){ return null; }
}
function clearProgress(){
  try { sessionStorage.removeItem(PROGRESS_KEY); } catch(e){}
}

/* Usage logging. Gated by consent, per spec. Posts to the Cloudflare
   Worker (which tags a country code and forwards to Supabase) on both
   quiz start and finish, sharing one attempt_id between the two rows.
   Fire-and-forget: a failed or slow request never blocks or breaks the
   quiz for the pupil. */
var LOG_ENDPOINT = "https://mcq-logger.andrewspero.workers.dev";
var attemptId = null;

function getVisitorId(){
  try {
    var id = localStorage.getItem("mcq_visitor_id");
    if (!id) {
      id = (crypto.randomUUID ? crypto.randomUUID() : (String(Date.now()) + Math.random().toString(16).slice(2)));
      localStorage.setItem("mcq_visitor_id", id);
    }
    return id;
  } catch(e){ return null; }
}

function logAttempt(status){
  if (!state.consent) return;
  if (status === "started") attemptId = (crypto.randomUUID ? crypto.randomUUID() : String(Date.now()));
  var visitorId = getVisitorId();
  if (!attemptId || !visitorId) return;
  var scoreInfo = status === "completed" ? computeScore() : null;
  var payload = {
    attempt_id: attemptId, visitor_id: visitorId, quiz_id: QUIZ_ID, quiz_title: quiz.title, status: status,
    score: scoreInfo ? scoreInfo.correct : null, total_questions: quiz.questions.length
  };
  try {
    fetch(LOG_ENDPOINT, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(payload)
    }).catch(function(){ /* silent - logging must never break the quiz for the pupil */ });
  } catch(e){ /* silent, same reason */ }
}

function computeScore(){
  var correct = 0, total = 0;
  quiz.questions.forEach(function(q, idx){
    if (q.broken) return;
    total++;
    var a = state.answered[idx];
    if (a && a.correct) correct++;
  });
  return { correct: correct, total: total };
}

